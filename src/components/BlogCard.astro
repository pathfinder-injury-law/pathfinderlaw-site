---
import { longDate, type BlogPost } from '../data/blogPosts';
interface Props { post: BlogPost }
const { post } = Astro.props;
---
<article class="blog-card">
  <p class="blog-card-meta"><time datetime={post.date.toISOString()}>{longDate(post.date)}</time></p>
  <h3><a href={post.path}>{post.title}</a></h3>
  <p class="blog-card-text">{post.description}</p>
  <a class="blog-card-more" href={post.path} aria-label={`Read more: ${post.title}`}>Read more <span aria-hidden="true">→</span></a>
</article>
<style is:global>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--sage);
    border-top: 0.3rem solid var(--moss);
    border-radius: var(--radius);
    padding: 1.5rem 1.5rem 1.4rem;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .blog-card-meta {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pine);
  }
  .blog-card h3 {
    margin: 0 0 0.7rem;
    font-size: 1.3rem;
    line-height: 1.25;
  }
  .blog-card h3 a {
    text-decoration: none;
  }
  .blog-card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--moss);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .blog-card-text {
    margin: 0 0 1.1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(41, 70, 52, 0.85);
  }
  .blog-card-more {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--pine);
  }
  .blog-card-more:hover {
    color: var(--forest);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>

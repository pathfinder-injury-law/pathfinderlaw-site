---
// The contact form. PREVIEW ONLY: it checks the fields and says nothing was
// sent. LAUNCH BLOCKER: replace with the real spam-protected submission
// (migration plan, "Contact form and spam pipeline") before the live site goes out.
const { id = 'contact-form' } = Astro.props;
---
<div class="form-card">
  <h3>Speak To An Attorney</h3>
  <form class="contact-form" id={id} method="post" action="/contact/" novalidate>
    <div class="field">
      <label for={`${id}-name`}>Name*</label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field-pair">
      <div class="field">
        <label for={`${id}-email`}>Email*</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for={`${id}-phone`}>Phone Number*</label>
        <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" required />
      </div>
    </div>
    <div class="field">
      <label for={`${id}-message`}>Message*</label>
      <textarea id={`${id}-message`} name="message" required></textarea>
      <p class="field-hint">Please keep this short. Do not include confidential or sensitive details yet.</p>
    </div>
    <!-- Required acknowledgement (ethics review, LEO 1842). Wording drafted with the owner and approved by him. -->
    <div class="consent">
      <input id={`${id}-consent`} name="acknowledged" type="checkbox" required />
      <label for={`${id}-consent`}>
        I understand that sending this inquiry does not create an attorney-client relationship, and
        that confidentiality and conflict protections may not apply until one begins. I am not
        represented by Pathfinder Injury Law unless an authorized firm representative and I have
        both signed a written representation agreement.*
      </label>
    </div>
    <!-- Spam trap: people never see this field, bots fill it in. -->
    <div class="hp" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button class="btn btn-primary" type="submit">Send To An Attorney</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const status = form.querySelector('.form-status') as HTMLElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = 'Please fill in every field marked with a star, including the acknowledgement.';
        form.reportValidity();
        return;
      }
      status.textContent = 'Preview only: this form is not connected yet, so nothing was sent.';
    });
  });
</script>

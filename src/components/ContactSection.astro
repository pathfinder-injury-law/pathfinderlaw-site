---
import Photo from './Photo.astro';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';

// variant "plain": the Contact page version, the form alone on a light background (no dark band).
// variant "link": the home page version. The form already sits near the top of that page, so this
// band keeps the phone number and sends people up to the form instead of showing a second one.
const { variant = 'band' } = Astro.props;
---
{variant === 'link' ? (
<section class="section cta cta-link contour on-dark" id="free-consultation">
  <Photo class="cta-bg" src="/images/photos/tile-c.jpg" alt="" width="1400" height="1050" sizes="100vw" loading="lazy" />
  <div class="wrap" data-reveal>
    <ul class="cta-points caps">
      <li>No Pressure</li>
    </ul>
    <h2>Free Consultation</h2>
    <hr class="rule" />
    <p class="lede">Learn how we can help you with your Workers’ Comp case.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="#contact">Start Your Free Consultation</a>
      <a class="cta-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
    </div>
  </div>
</section>
) : variant === 'plain' ? (
  <section class="section cta-plain" id="contact">
    <div class="wrap cta-plain-wrap">
      <ContactForm />
    </div>
  </section>
) : (
<section class="section cta contour on-dark" id="contact">
  <Photo class="cta-bg" src="/images/photos/tile-c.jpg" alt="" width="1400" height="1050" sizes="100vw" loading="lazy" />
  <div class="wrap cta-grid">
    <div data-reveal>
      <ul class="cta-points caps">
        <li>No Pressure</li>
      </ul>
      <h2>Free Consultation</h2>
      <hr class="rule" />
      <p class="lede">Learn how we can help you with your Workers’ Comp case.</p>
      <a class="cta-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
    </div>
    <div data-reveal>
      <ContactForm />
    </div>
  </div>
</section>
)}

---
import Photo from './Photo.astro';
import ContactForm from './ContactForm.astro';
import MapContact from './MapContact.astro';
import { site } from '../data/site';

// variant "plain": the Contact page version, the form alone on a light background (no dark band).
// variant "band" (the default, on about 19 inner pages): since Nov 3 2026 the home page's form in a map (MapContact)
// instead of the skyline photo band, with the same words.
// variant "link": the home page version. The form already sits near the top of that page, so this
// band keeps the phone number and sends people up to the form instead of showing a second one.
const { variant = 'band' } = Astro.props;
---
{variant === 'link' ? (
<section class="section cta cta-link contour tex-img on-dark" id="free-consultation">
  <img class="contour-tex" data-src="/images/contour-map.svg" alt="" width="2560" height="1600" loading="lazy" decoding="async" />
  <Photo class="cta-bg" src="/images/photos/tile-c.jpg" alt="" width="1400" height="1050" sizes="100vw" loading="lazy" />
  <div class="wrap" data-reveal>
    <ul class="cta-points caps">
      <li>No Pressure</li>
    </ul>
    <h2>Free Consultation</h2>
    <hr class="rule" />
    <p class="lede">Learn how we can help you with your Workers’ Comp case.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="#contact">Start Your Free Consultation</a>
      <a class="cta-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
    </div>
  </div>
</section>
) : variant === 'plain' ? (
  <section class="section cta-plain" id="contact">
    <div class="wrap cta-plain-wrap">
      <ContactForm />
    </div>
  </section>
) : (
<MapContact class="on-dark mc-band">
  <ul class="cta-points caps">
    <li>No Pressure</li>
  </ul>
  <h2>Free Consultation</h2>
  <hr class="rule" />
  <p class="lede">Learn how we can help you with your Workers’ Comp case.</p>
  <a class="cta-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
</MapContact>
)}

<style is:global>
  /* The form band's headline in the home page's heavy type, in cream. */
  .mc-band h2 { font-size: clamp(2.25rem, 4.6vw, 3.75rem); font-weight: 900; line-height: 1.02; letter-spacing: -0.02em; color: #fff5d5; margin: 0 0 0.3em; }
  .mc-band .lede { color: #e9efdf; margin-bottom: 1.25rem; }
</style>

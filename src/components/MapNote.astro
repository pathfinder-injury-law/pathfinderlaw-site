---
import { compass } from '../data/doodles';

// The 404 and thank-you body (Nov 4): the form's map band (forest, contour lines, compass, dotted trail), finished
// two ways. "lost": the trail loops back on itself and ends at a yellow "?". "found": the trail runs to the yellow X.
// The words go in the default slot, in cream. The drawing is decoration only (aria-hidden).
interface Props {
  mood: 'lost' | 'found';
}
const { mood } = Astro.props;
const trail =
  mood === 'lost'
    ? 'M118 90C170 70 230 40 270 70S300 160 240 170S150 130 190 100S300 120 300 200S220 250 170 220'
    : 'M140 90C200 100 230 150 270 170S310 200 318 214';
const mark = mood === 'lost' ? 'M150 196c0-12 9-20 20-20s20 8 20 18c0 10-12 13-15 22v6M175 238v.5' : 'M306 202l24 24M330 202l-24 24';
const needle = mood === 'lost' ? -118 : 62;
---
<section class="map-note">
  <div class="wrap mn-grid">
    <div class="mn-words"><slot /></div>
    <div class="mn-art" aria-hidden="true">
      <svg class="mn-compass" viewBox="0 0 120 130" focusable="false"><path d={compass.ring} /><path class="dots" d={compass.dots} /><path transform={`rotate(${needle} 60 70)`} d={compass.needle} /></svg>
      <svg class="mn-path" viewBox="0 0 352 256" preserveAspectRatio="xMinYMin meet" focusable="false"><path class="trail" d={trail} /><path class="mark" d={mark} /></svg>
    </div>
  </div>
</section>

<style>
  .map-note { position: relative; isolation: isolate; background: var(--forest); color: #e9efdf; padding: clamp(3.5rem, 7vw, 6rem) 0; }
  .map-note::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: #e9efdf; opacity: 0.1; -webkit-mask: url(/images/contours.svg) center / 90rem auto repeat; mask: url(/images/contours.svg) center / 90rem auto repeat; }
  .mn-grid { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 4rem; align-items: center; }
  .mn-words :global(.lead) { color: #fff5d5; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.4; max-width: 34rem; }
  .mn-words :global(p) { color: #e9efdf; }
  .mn-words :global(a:not(.btn)) { color: #fff; text-decoration-color: var(--sun); text-underline-offset: 5px; }
  .mn-words :global(ul) { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; }
  .mn-words :global(li a) { font-weight: 700; }
  .mn-art { position: relative; width: 100%; aspect-ratio: 352 / 256; color: #e9efdf; }
  .mn-compass { position: relative; z-index: 1; width: 41%; height: auto; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  .mn-compass path { vector-effect: non-scaling-stroke; }
  .mn-compass .dots { stroke-dasharray: 0.1 5; stroke-width: 2.4; }
  .mn-path { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .mn-path .trail { fill: none; stroke: #e9efdf; stroke-opacity: 0.6; stroke-width: 2.5; stroke-dasharray: 0.1 9; stroke-linecap: round; }
  .mn-path .mark { fill: none; stroke: var(--sun); stroke-width: 3.4; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 61.99rem) { .mn-grid { grid-template-columns: 1fr; gap: 2rem; } .mn-art { max-width: 17rem; } }
</style>

---
import Photo from './Photo.astro';
import { compass } from '../data/doodles';

interface Props {
  title: string;
  // Breadcrumb trail after "Home". The last item is the current page.
  crumbs?: { name: string; href?: string }[];
  image?: string;
  // Contact page: the big "Hurt? / Let's talk." lockup under the small page heading.
  lockup?: { line1: string; line2: string };
}
const { title, crumbs = [], image = '/images/photos/e4-misty-river.jpg', lockup } = Astro.props;
---
<section class:list={['page-hero', 'on-dark', lockup && 'page-hero-lockup']}>
  <Photo class="hero-photo" src={image} alt="" width="2000" height="1333" sizes="100vw" fetchpriority="high" />
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => (
          <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
        ))}
      </ol>
    </nav>
    <!-- Bryn's pick "A" (Nov 4): one cream compass on the photo band, beside the title. Drawn inline, so no request. -->
    <svg class="hero-compass" viewBox="0 0 120 130" aria-hidden="true" focusable="false"><path d={compass.ring} /><path class="dots" d={compass.dots} /><path transform="rotate(24 60 70)" d={compass.needle} /></svg>
    <h1>{title}</h1>
    {lockup && (
      <div class="lockup">
        <p class="hero-l1">{lockup.line1}</p>
        <p class="hero-l2">{lockup.line2}</p>
      </div>
    )}
  </div>
</section>

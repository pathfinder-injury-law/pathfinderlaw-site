---
import '@fontsource-variable/figtree';
// The main text font file (Latin letters, the only part most pages use), so it can be preloaded below.
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site';
import { cities } from '../data/cities';
import pageDates from '../data/pageDates.json';

interface Props {
  title: string;
  description: string;
  // Path of this page, with leading and trailing slash, e.g. "/" or "/results/".
  path: string;
  // Breadcrumb trail after "Home". Empty on the home page.
  crumbs?: { name: string; path: string }[];
  datePublished?: string;
  // True when a full-width photo sits behind the header.
  overlay?: boolean;
  // True when the photo behind the header is pale (a light sky), so the menu uses dark text.
  heroLight?: boolean;
  // Practice-area and blog pages credit Bryn Swartz as author, as the old site did.
  author?: boolean;
  // Pages that must stay out of search results even on the live site (404, thank-you).
  noindex?: boolean;
}

const { title, description, path, crumbs = [], datePublished, overlay = false, heroLight = false, author = false, noindex = false } = Astro.props;
const origin = Astro.site!.origin;
const url = new URL(path, origin).href;
const image = new URL('/images/open-graph-card.jpg', origin).href;

// Pages are hidden from search engines unless the build says the site is live.
// Previews never set PUBLIC_SITE_LIVE, so they stay hidden by default.
// A page can opt out of the live setting with the noindex prop.
const live = import.meta.env.PUBLIC_SITE_LIVE === '1';
// Blog posts pass datePublished; so does the home page (for its WebPage data), which stays a website.
const ogType = datePublished && path !== '/' ? 'article' : 'website';
const robots = live && !noindex ? 'max-image-preview:large' : 'noindex, nofollow, max-image-preview:large';

// LegalService (local-business) data, built from src/data/site.ts and the city pages so it cannot drift.
// Deliberately absent: geo coordinates (not in site.ts; they must come from the Google Maps pin),
// ratings and review counts, and any spoken-language property (Bryn's S4 decision: interpreter or
// translation service only, never "staff speak Spanish").
const addressOf = (o: { lines: string[] }) => {
  const m = o.lines[1].match(/^(.*), ([A-Z]{2}) (\d{5})$/)!;
  return { '@type': 'PostalAddress', streetAddress: o.lines[0], addressLocality: m[1], addressRegion: m[2], postalCode: m[3], addressCountry: 'US' };
};
const virginia = { '@type': 'State', name: 'Virginia' };
// One LegalService per office, so each address can be matched to its own Google Business Profile.
// The firm-wide LegalService below points to them by id.
const officeId = (o: { name: string }) => `${origin}/#legalservice-${o.name.toLowerCase()}`;
const offices = site.offices.map((o) => ({
  '@type': 'LegalService',
  '@id': officeId(o),
  name: `${site.name}, ${o.name} office`,
  url: new URL(o.page?.href ?? '/', origin).href,
  telephone: '+18045050633',
  address: addressOf(o),
  hasMap: o.mapUrl,
  logo: { '@id': `${origin}/#organizationLogo` },
  image: { '@id': `${origin}/#organizationLogo` },
  parentOrganization: { '@id': `${origin}/#organization` },
  // No opening hours: meetings at both offices are by appointment only. Google's advice for
  // appointment-only businesses is to list no hours. The 9 to 5 phone hours go on the firm-wide
  // ContactPoint instead (Bryn, Nov 2).
}));
// Bryn, with the career facts from his bio page (/bryn-swartz/). The old author address
// (/author/brynswartz/) does not exist on the new site, so the author points to the bio page.
const person = {
  '@type': 'Person',
  '@id': `${origin}/#author`,
  name: 'Bryn Swartz',
  url: `${origin}/bryn-swartz/`,
  image: `${origin}/images/photos/bryn.jpg`,
  jobTitle: 'Owner & Attorney',
  description:
    'Virginia workers’ compensation lawyer, licensed in Virginia since 2011. Former prosecutor with the Virginia Office of the Attorney General. Founded Pathfinder Injury Law in 2019.',
  worksFor: { '@id': `${origin}/#organization` },
  knowsAbout: ['Workers’ compensation', 'Virginia workers’ compensation law'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'license',
    name: 'Licensed to practice law in Virginia',
    dateCreated: '2011',
    recognizedBy: { '@type': 'Organization', name: 'Virginia State Bar', url: 'https://www.vsb.org/' },
  },
  hasOccupation: { '@type': 'Occupation', name: 'Attorney', occupationLocation: virginia },
  // Schools, and the office where he was a prosecutor.
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Randolph-Macon College' },
    { '@type': 'CollegeOrUniversity', name: 'University of Richmond School of Law' },
    { '@type': 'GovernmentOrganization', name: 'Virginia Office of the Attorney General' },
  ],
  memberOf: [
    { '@type': 'Organization', name: 'Virginia State Bar' },
  ],
  sameAs: site.social.filter((s) => s.name === 'LinkedIn').map((s) => s.url),
};
// The full Person goes on pages that credit Bryn as author and on his own bio page.
const withPerson = author || path === '/bryn-swartz/';
// The Eastern Shore page is covered by its two counties, so it is not listed as a separate area.
const cityAreas = cities
  .filter((c) => c.path !== '/eastern-shore-workers-comp-lawyer/')
  .map((c) => ({
    '@type': /County$/.test(c.name) ? 'AdministrativeArea' : 'City',
    name: c.name,
    containedInPlace: virginia,
  }));
const legalService = {
  '@type': 'LegalService',
  '@id': `${origin}/#legalservice`,
  name: site.name,
  url: `${origin}/`,
  telephone: '+18045050633',
  description:
    'Virginia Workers’ Comp law firm with offices in Richmond and Chincoteague. Calls, texts, and email Monday to Friday, 9 a.m. to 5 p.m. Meetings at both offices are by appointment only.',
  logo: { '@id': `${origin}/#organizationLogo` },
  image: { '@id': `${origin}/#organizationLogo` },
  parentOrganization: { '@id': `${origin}/#organization` },
  location: offices.map((o) => ({ '@id': o['@id'] })),
  // When the firm answers calls, texts and email. These are contact hours, not office hours.
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+18045050633',
    areaServed: virginia,
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: site.contactHours.days,
      opens: site.contactHours.opens,
      closes: site.contactHours.closes,
    },
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Accomack County', containedInPlace: virginia },
    { '@type': 'AdministrativeArea', name: 'Northampton County', containedInPlace: virginia },
    virginia,
    ...cityAreas,
  ],
};

// Article data for article pages: pages that credit Bryn as author, minus blog posts (they carry
// BlogPosting, and they are the pages that pass datePublished), city pages, and the practice pages
// below, which describe the firm's service rather than answer a question. A new article page built
// the same way gets this block with no change here.
const practicePages = new Set([
  '/virginia-workers-comp-lawyer/',
  '/virginia-work-injury-lawyer/',
  '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/',
  '/virginia-construction-accident-lawyer/',
  '/virginia-factory-accident-lawyer/',
  '/car-accident-at-work-in-virginia/',
]);
const isArticle = author && !datePublished && !practicePages.has(path) && !cities.some((c) => c.path === path);
// The headline is the page's H1, which every article page passes as its last breadcrumb.
// dateModified is the page's own sitemap date (src/data/pageDates.json, from git). There is no
// datePublished: no true first-publish date exists for these pages, and none is guessed.
const modified = (pageDates as Record<string, string>)[path];
const article = isArticle && crumbs.length
  ? {
      '@type': 'Article',
      '@id': `${url}#article`,
      mainEntityOfPage: { '@id': `${url}#webpage` },
      headline: crumbs[crumbs.length - 1].name,
      description,
      url,
      inLanguage: 'en-US',
      ...(modified ? { dateModified: modified } : {}),
      author: { '@type': 'Person', '@id': `${origin}/#author`, name: 'Bryn Swartz', url: `${origin}/bryn-swartz/` },
      publisher: { '@id': `${origin}/#organization` },
      isPartOf: { '@id': `${origin}/#website` },
      image,
    }
  : null;

// Structured data: the same four blocks the current site carries on every page, plus LegalService above.
const trail = [{ name: 'Home', path: '/' }, ...crumbs];
const graph = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumblist`,
    itemListElement: trail.map((c, i) => ({
      '@type': 'ListItem',
      '@id': new URL(c.path, origin).href + (i === trail.length - 1 ? '#listItem' : ''),
      position: i + 1,
      name: c.name,
      // Google needs the crumb's page address in `item`, not only in `@id`.
      item: new URL(c.path, origin).href,
    })),
  },
  {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: site.name,
    description: site.tagline,
    url: `${origin}/`,
    telephone: '+18045050633',
    logo: {
      '@type': 'ImageObject',
      url: `${origin}/images/brand/logo-horizontal.png`,
      '@id': `${origin}/#organizationLogo`,
      width: 1703,
      height: 522,
    },
    image: { '@id': `${origin}/#organizationLogo` },
    foundingDate: '2019',
    founder: { '@type': 'Person', '@id': `${origin}/#author`, name: 'Bryn Swartz' },
    sameAs: site.social.map((s) => s.url),
  },
  legalService,
  ...offices,
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': `${origin}/#website` },
    breadcrumb: { '@id': `${url}#breadcrumblist` },
    ...(author ? { author: { '@id': `${origin}/#author` }, creator: { '@id': `${origin}/#author` } } : {}),
    ...(datePublished ? { datePublished } : {}),
    ...(path === '/bryn-swartz/' ? { mainEntity: { '@id': `${origin}/#author` } } : {}),
  },
  ...(withPerson ? [person] : []),
  ...(article ? [article] : []),
  {
    '@type': 'WebSite',
    '@id': `${origin}/#website`,
    url: `${origin}/`,
    name: site.name,
    description: site.tagline,
    inLanguage: 'en-US',
    publisher: { '@id': `${origin}/#organization` },
  },
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

// Instant page loads: when a visitor rests the pointer on a link to another page of this site (or
// starts to tap it), the browser loads that page ahead of time (Speculation Rules). Never for the form
// endpoint, the thank-you page, the feed or the sitemaps. Browsers without support ignore this.
const speculationRules = JSON.stringify({
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/api/*', '/thank-you', '/thank-you/*', '/feed', '/feed/*', '/*.xml'] } },
          { not: { selector_matches: '[rel~=nofollow], [target=_blank], [download]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Feed`} href="/feed/" />
    <link rel="icon" href="/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#294634" />
    <link rel="preload" as="font" type="font/woff2" href={figtreeLatin} crossorigin />

    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="522" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <slot name="head" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script type="speculationrules" set:html={speculationRules} />
  </head>
  <!-- Only the home page puts the header over its photo (overlay + heroLight). Since Nov 3 2026 the inner pages'
       photo bands are dark, so they keep the solid sage header bar above the photo instead (the logo stays on sage). -->
  <body class:list={[overlay && heroLight && 'has-overlay', heroLight && 'hero-light']}>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script is:inline>
      // Motion helpers. If anything here fails, the page simply shows normally.
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // The faint map texture (img.contour-tex, data-src) is decorative, so it loads only after the page has
        // finished loading. As a normal image or CSS background, phones fetched its 70 KB with the hero photo.
        function texture() {
          document.querySelectorAll('img.contour-tex[data-src]').forEach(function (img) {
            img.src = img.getAttribute('data-src');
            img.removeAttribute('data-src');
          });
        }
        if (document.readyState === 'complete') texture();
        else window.addEventListener('load', texture, { once: true });

        // Header turns solid once the page scrolls past the top.
        var header = document.querySelector('.site-header');
        function onScroll() { header && header.classList.toggle('is-solid', window.scrollY > 40); }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Phone Call / Message bar. Bryn, Nov 3 2026: "nonintrusive". It slides away while the reader
        // scrolls down and comes back as soon as they scroll up. It also steps aside where it would cover
        // something: the home page hero (which has its own Free Consultation button), the contact form and
        // the footer. Without script it stays visible.
        var bar = document.querySelector('.call-bar');
        if (bar && 'IntersectionObserver' in window) {
          var seen = new Set();
          var tucked = false;
          var apply = function () { bar.classList.toggle('is-hidden', seen.size > 0 || tucked); };
          // Reading direction: more than 8px down tucks the bar, more than 8px up brings it back. Near the top
          // (under 100px, including iOS rubber-band at negative scrollY) it always shows. The bounce past the
          // bottom is ignored; the footer observer already hides it there.
          var lastY = Math.max(window.scrollY, 0), ticking = false;
          window.addEventListener('scroll', function () {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function () {
              ticking = false;
              var y = window.scrollY;
              var max = document.documentElement.scrollHeight - window.innerHeight;
              if (y >= max - 2) return;
              var next = tucked;
              if (y < 100) next = false;
              else if (Math.abs(y - lastY) < 8) return;
              else next = y > lastY;
              lastY = Math.max(y, 0);
              if (next !== tucked) { tucked = next; apply(); }
            });
          }, { passive: true });
          var bio = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) seen.add(e.target); else seen.delete(e.target); });
            apply();
          });
          document.querySelectorAll('#contact, form, .site-footer').forEach(function (el) { bio.observe(el); });
          var heroEl = document.querySelector('.hero');
          if (heroEl) {
            seen.add(heroEl); // hidden from the first paint, so it never flashes over the hero
            apply();
            bio.observe(heroEl);
          }
        }

        // Dollar amounts count up the first time they appear.
        function countUp(el) {
          var target = parseInt(el.getAttribute('data-count'), 10);
          if (!target || reduce) return;
          var start = null, dur = 1600;
          function step(t) {
            if (start === null) start = t;
            var p = Math.min((t - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = '$' + Math.round(target * eased).toLocaleString('en-US');
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }

        // Fade-up on scroll.
        var els = document.querySelectorAll('[data-reveal], [data-stagger]');
        if (!('IntersectionObserver' in window) || !els.length) return;
        document.documentElement.classList.add('js');
        // Start just before a section scrolls into view, so nothing below the hero looks empty.
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            e.target.querySelectorAll('[data-count]').forEach(countUp);
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px 20% 0px', threshold: 0 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  // Path of this page, with leading and trailing slash, e.g. "/" or "/results/".
  path: string;
  // Breadcrumb trail after "Home". Empty on the home page.
  crumbs?: { name: string; path: string }[];
  datePublished?: string;
}

const { title, description, path, crumbs = [], datePublished } = Astro.props;
const origin = Astro.site!.origin;
const url = new URL(path, origin).href;
const image = new URL('/images/open-graph-card.jpg', origin).href;

// Pages are hidden from search engines unless the build says the site is live.
// Previews never set PUBLIC_SITE_LIVE, so they stay hidden by default.
const live = import.meta.env.PUBLIC_SITE_LIVE === '1';
const robots = live ? 'max-image-preview:large' : 'noindex, nofollow, max-image-preview:large';

// Structured data: the same four blocks the current site carries on every page.
const trail = [{ name: 'Home', path: '/' }, ...crumbs];
const graph = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumblist`,
    itemListElement: trail.map((c, i) => ({
      '@type': 'ListItem',
      '@id': new URL(c.path, origin).href + (i === trail.length - 1 ? '#listItem' : ''),
      position: i + 1,
      name: c.name,
    })),
  },
  {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: site.name,
    description: site.tagline,
    url: `${origin}/`,
    telephone: '+18045050633',
    logo: {
      '@type': 'ImageObject',
      url: `${origin}/images/brand/logo-horizontal.png`,
      '@id': `${origin}/#organizationLogo`,
      width: 1703,
      height: 522,
    },
    image: { '@id': `${origin}/#organizationLogo` },
    sameAs: site.social.map((s) => s.url),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': `${origin}/#website` },
    breadcrumb: { '@id': `${url}#breadcrumblist` },
    ...(datePublished ? { datePublished } : {}),
  },
  {
    '@type': 'WebSite',
    '@id': `${origin}/#website`,
    url: `${origin}/`,
    name: site.name,
    description: site.tagline,
    inLanguage: 'en-US',
    publisher: { '@id': `${origin}/#organization` },
  },
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="522" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

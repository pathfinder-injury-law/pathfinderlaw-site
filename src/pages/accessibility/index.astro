---
import InfoPage from '../../components/InfoPage.astro';

// DRAFT. This accessibility statement is not approved yet. It needs Bryn Swartz's approval
// before the site goes live. It makes no claim of full conformance.
const title = 'Accessibility Statement - Pathfinder Injury Law';
const description =
  'Pathfinder Injury Law aims to make this website usable by everyone. Read our accessibility statement and tell us about any problems you find.';
---
<InfoPage title={title} description={description} path="/accessibility/" h1="Accessibility Statement">
  <p>
    Pathfinder Injury Law wants this website to be usable by everyone, including people with
    disabilities. We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at Level AA.
  </p>
  <p>
    We are still working on parts of this website, and we have not checked every page against every
    guideline. This statement does not mean that every page fully meets WCAG 2.2 AA.
  </p>
  <h2>Tell Us About a Problem</h2>
  <p>
    If you have trouble using any part of this website, or you need information in another format,
    please tell us. Call us at <a href="tel:+18045050633">804-505-0633</a>, or send a message through
    our <a href="/contact/">contact page</a>.
  </p>
  <h2>Our Offices</h2>
  <p>
    Our Richmond and Chincoteague offices are open by appointment only. Please call ahead to arrange
    a visit.
  </p>
</InfoPage>

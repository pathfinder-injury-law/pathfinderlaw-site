  .e4 .dia picture, .e4 .dia img { display: block; }
  .e4 .dia img { width: 142%; height: 142%; max-width: none; margin: -21%; transform: rotate(-45deg); object-fit: cover; }
  .e4 .dia-card:hover .dia, .e4 .dia-card:focus-visible .dia { box-shadow: 0 0 0 6px var(--forest), 0 0 0 9px var(--amber); }

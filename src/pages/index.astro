  .e4 .note:nth-child(1) { transform: rotate(-0.6deg); }
  .e4 .note:nth-child(2) { transform: rotate(0.5deg) translateY(10px); }
  .e4 .note:nth-child(3) { transform: rotate(-0.3deg); }
  .e4 .note .stars { width: 94px; height: 18px; fill: var(--amber); display: block; margin-bottom: 0.75rem; }
  .e4 .note blockquote { margin: 0; font-size: 1.1875rem; line-height: 1.6; font-weight: 500; }
  .e4 .note blockquote p { margin: 0; }
  .e4 .note figcaption { font-size: 2.125rem; color: var(--act-e4); margin-top: 0.9rem; }
  .e4 .e4-quotes .fine { color: #e9efdf; }
  @media (max-width: 47.99rem) { .e4 .notes { grid-template-columns: 1fr; gap: 1.9rem; } .e4 .note:nth-child(n) { transform: rotate(-1deg); } .e4 .e4-quotes { padding: 4rem 0; } }

  /* Steps */
  .e4 .e4-steps { background: var(--sage-e4); padding: 6rem 0; }
  .e4 .cards { position: relative; margin-top: 9.5rem; }
  .e4 .card-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; position: relative; z-index: 1; }
  .e4 .card { background: #f4f7ef; border-top: 5px solid var(--moss); border-radius: 14px; padding: 1.6rem 1.4rem; }
  .e4 .card h3 { font-size: 1.3125rem; line-height: 1.2; margin: 0 0 0.6rem; }
  .e4 .card p { font-size: 1rem; margin: 0; color: #3d5546; }
  .e4 .card .tl { display: inline-block; margin-top: 0.5rem; text-decoration-color: var(--amber); color: var(--forest); }
  .e4 .num { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; font-weight: 800; font-size: 1.375rem; margin-bottom: 1rem; }
  .e4 .num::before { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: var(--sun); z-index: -1; }
  .e4 .num svg { position: absolute; inset: -8px; width: 60px; height: 60px; fill: var(--forest); }
  .e4 .trail { position: absolute; left: 0; top: -62px; height: 56px; width: 100%; fill: var(--amber); }
  .e4 .here { position: absolute; left: -10px; top: -128px; font-size: 2.125rem; color: var(--act-e4); transform: rotate(-5deg); margin: 0; z-index: 3; }
  .e4 .here svg { display: block; width: 40px; height: 44px; margin-left: 40px; fill: currentColor; }
  @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
    .e4 .pinwrap { height: 300vh; padding: 0; }
    .e4 .pin { position: sticky; top: 0; height: 100vh; display: grid; align-content: center; }
    .e4 .pinwrap.on .card { opacity: 0.4; transform: translateY(14px); transition: opacity 0.45s, transform 0.45s, box-shadow 0.45s; }
    .e4 .pinwrap.on .card.lit { opacity: 1; transform: none; }
    .e4 .pinwrap.on .card.now { box-shadow: 0 10px 30px rgba(41, 70, 52, 0.16); }
    .e4 .pinwrap.on .num svg { opacity: 0; transition: opacity 0.4s; }
    .e4 .pinwrap.on .card.lit .num svg { opacity: 1; }
    .e4 .pinwrap.on .here { transition: transform 0.5s ease; }
  }
  @media (max-width: 47.99rem) {
    .e4 .e4-steps { padding: 4rem 0; }
    .e4 .cards { margin-top: 4.1rem; }
    .e4 .card-list { grid-template-columns: 1fr; }
    .e4 .trail, .e4 .here svg { display: none; }
    .e4 .here { top: -3.4rem; left: 0; font-size: 1.75rem; }

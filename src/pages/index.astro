  @media (max-width: 47.99rem) { .e4 .e4-results { padding: 4rem 0; } .e4 .rgrid { grid-template-columns: 1fr 1fr; gap: 1.4rem; } .e4 .amount { font-size: 1.75rem; } .e4 .paper { width: 70px; height: 64px; top: -20px; } }


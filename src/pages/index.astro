  }

  /* Hero */
  .e4 .hero-e4 { position: relative; min-height: 100svh; max-height: 68rem; overflow: hidden; color: var(--cream); display: flex; align-items: flex-end; }
  .e4 .hero-e4 .hero-pic, .e4 .hero-e4 .hero-photo { position: absolute; inset: var(--hero-top, 7.5rem) 0 0 0; width: 100%; height: calc(100% - var(--hero-top, 7.5rem)); object-fit: cover; object-position: 70% 0%; }

---
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import variants from '../data/imageVariants.json';
import { site } from '../data/site';

// Home page, design E4 (Nov 2, 2026), wilderness-to-map version (outside review, 11-02-26).
// One idea top to bottom: a real wilderness photo up top, faint map contour lines taking over as you
// scroll, and the form inside a map at the end, where the trail stops at an X. Rules: one art layer
// per section (a photo or map lines, never both), the map stays behind things, and about five small
// single-line doodles at the edges. No doodles in the hero, in Results, or near any disclaimer.
// "We've got this." is the page's only handwriting.
// Nov 3 (Bryn): the motif goes lost, then bearings, then guided. The hero is the lost moment; a line-drawn
// compass appears at the band (needle a little off north), the steps read as field notes and the help photos
// as field-guide plates, and at the form a second compass points along the trail to the X. Six drawn marks now;
// binoculars join when the "Two people" section is built (Bryn OK'd seven).
// The search text and links from the Nov 1 SEO rewrite are kept (intro paragraphs, topic links, results links).

const heroSet = (crop: 'desktop' | 'phone', fmt: 'avif' | 'webp') =>
  (variants as any)[`/images/photos/e4-trail-map-${crop}.webp`][fmt].map((v: { url: string; width: number }) => `${v.url} ${v.width}w`).join(', ');

const title = "Pathfinder Injury Law | Virginia Workers' Comp Lawyer";
const description =
  "Pathfinder Injury Law handles only Virginia workers' comp, only for injured workers. Offices in Richmond and Chincoteague. Free consultation: 804-505-0633.";

// Word for word from /reviews/ (initials only, as there). No results or comparisons (LEO 1750 section G).
const reviews = [
  { by: 'M.W.', text: 'They guided the way when I needed help the most. Very knowledgeable, respectful of my situation and always there whenever I had questions.' },
  { by: 'T.B.', text: 'The team at Pathfinders was very professional, attentive and knowledgeable. Mr. Swartz made certain that I understood my rights and walked me through the process.' },
  { by: 'K.W.', text: 'Pathfinder Injury Law was extremely helpful, knowledgeable, personable, and ensured that I understood each step of the process.' },
];

// Bryn's own steps (Nov 2), legal-checked. Step 3 is his reworded line after the check.
const steps = [
  { title: 'Free consultation', text: 'We discuss your case in a free, no-pressure consultation with Bryn, Mandy, or both.' },
  { title: 'We do our homework', text: 'We research any issues and figure out if we can help. We make sure there are no conflicts of interest or other problems.' },
  { title: 'Good fit or not', text: 'If it’s a good fit, we offer to help. If not, we tell you why. We’ll point you to another lawyer if we know someone who might be able to help.' },
  { title: 'We get to work', text: 'Paperwork is signed and we get to work.', link: { href: '/what-happens-when-you-file-a-workers-comp-claim/', label: 'How filing a claim works' } },
];

const help = [
  { title: 'Starting a claim', text: 'Just got hurt? Here’s what to do first.', href: '/how-to-file-a-workers-comp-claim/', img: '/images/photos/e4-farm-road.jpg' },
  { title: 'Denied claims', text: 'A denial isn’t the end. Here’s how appeals work.', href: '/how-to-appeal-a-workers-comp-denial-in-virginia/', img: '/images/photos/e4-autumn-ridges.jpg' },
  { title: 'Settlements', text: 'What a settlement covers, and what it closes.', href: '/workers-comp-settlement-in-virginia/', img: '/images/photos/e4-green-valley.jpg' },
];

const topics = [
  { label: 'What Virginia workers’ comp pays', href: '/virginia-workers-comp-lawyer/' },
  { label: 'Construction accidents', href: '/virginia-construction-accident-lawyer/' },
  { label: 'Factory accidents', href: '/virginia-factory-accident-lawyer/' },
  { label: 'Vehicle accidents', href: '/car-accident-at-work-in-virginia/' },
  { label: 'Back injuries', href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/' },
  { label: 'Workers’ comp FAQ', href: '/virginia-workers-comp-faq/' },
];

// Same wording and links as before the redesign (legal-checked).
const results = [
  {
    amount: '$1,200,000',
    text: 'Settlement obtained in a heavily contested ankle injury case with bodywide CRPS involvement and multiple compensable consequences following a mediation before the Virginia Workers’ Compensation Commission.',
    linkText: 'ankle injury',
    href: '/ankle-injury-workers-comp/',
  },
  {
    amount: '$360,000',
    text: 'Settlement obtained in a Virginia Workers’ Compensation case involving a back injury 10 years prior.',
    linkText: 'back injury',
    href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/',
  },
  {
    amount: '$250,000',
    text: 'Settlement obtained in a contested concussion/brain injury Workers’ Compensation case with psychosomatic issues following mediation before the Virginia Workers’ Compensation Commission.',
  },
  {
    amount: '$240,000',
    text: 'Settlement obtained in a lumbar herniation case before the Virginia Workers’ Compensation Commission.',
    linkText: 'lumbar herniation',
    href: '/what-should-you-do-if-you-have-a-spine-injury-at-work/',
  },
];

// Rotating type-outs (Bryn, Nov 3). The first phrase of each list is the sentence that is in the HTML,
// so Google, screen readers and visitors without scripts always get one complete sentence.
const bandPhrases = ['hurt at work', 'losing wages', 'needing surgery', 'with denied claims', 'with lots of questions', 'who need a hand'];
const formPhrases = ['what happened', 'your injury', 'lost wages', 'surgery', 'why your claim was denied', 'what comes next'];

// The doodles: one line weight, rounded ends, no fill, one ink color per background (set in CSS).
// None may suggest a win (no trophies, flags, money or summit poses).
const doodle = {
  // peeking over the top edge of a quote card: shaggy head, two eyes, fingers on the edge
  yeti: 'M12 42C12 22 21 12 32 12S52 22 52 42M27 13C27 9 29 7 31 6M33 12C34 9 36 8 38 8M21 42C21 31 26 25 32 25S43 31 43 42M28 32m-1.3 0a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0-2.6 0M36 32m-1.3 0a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0-2.6 0M29.5 37q2.5 1.6 5 0M2 42q2-5 4 0q2-5 4 0q2-5 4 0M50 42q2-5 4 0q2-5 4 0q2-5 4 0',
  // riding the trail line
  biker: 'M14 36m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0M50 36m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0M14 36H28L22 24M28 36L42 22L50 36M22 24H42M42 22L40 17H45M18 22H25M40 8m-3.5 0a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0M38 12L25 21M36 14L42 18M25 21L32 28L28 35',
  // perched on the top edge of a photo
  bird: 'M27 10m-5.5 0a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0M32.5 9L37 10.5L32 12M28.5 9m-0.6 0a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0-1.2 0M22.5 13.5C27 17 26 25 17 25C12 25 8 22 3 19C9 19 13 14 22.5 13.5M11 19C15 21 19 20 21 17M15 25V30M19 25V30M13 30H17M17 30H21',
  // tucked behind a photo corner
  sun: 'M30 30m-10 0a10 10 0 1 0 20 0a10 10 0 1 0-20 0M30 15V8M30 52V45M15 30H8M52 30H45M19.4 19.4L14.4 14.4M45.6 45.6L40.6 40.6M40.6 19.4L45.6 14.4M14.4 45.6L19.4 40.6',
  // compass (120 x 130 box, centre 60,70): ring, dotted inner ring, cardinal ticks, a small N; the needle is
  // separate so it can turn. The needle is a diamond, like the logo mark.
  compassRing: 'M10 70a50 50 0 1 0 100 0a50 50 0 1 0-100 0M60 20V32M60 108V120M10 70H22M98 70H110M32.5 42.5L36 46M87.5 42.5L84 46M32.5 97.5L36 94M87.5 97.5L84 94M55 15V4L65 15V4',
  compassDots: 'M16 70a44 44 0 1 0 88 0a44 44 0 1 0-88 0',
  needle: 'M60 34L69 70L60 106L51 70ZM60 34V106M56.5 70a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0',
};
---
<Base
  title={title}
  description={description}
  path="/"
  datePublished="2022-02-25T23:07:43+00:00"
  overlay
  heroLight
>
  <Fragment slot="head">
    <!-- Start the hero photo download right away, in the size and format the browser will pick below. -->
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroSet('desktop', 'avif')} imagesizes="100vw" media="(min-width: 48rem)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroSet('phone', 'avif')} imagesizes="100vw" media="(max-width: 47.99rem)" fetchpriority="high" />
    <!-- Bryn's handwriting is in the headline, so fetch it early: a late swap would rewrap the hero (layout shift). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/kbs-handwriting.woff2" crossorigin />
  </Fragment>

  <div class="e4">
    <!-- Hero: one real photo edge to edge, words low left. -->
    <section class="hero hero-e4">
      <picture class="hero-pic">
        <source media="(max-width: 47.99rem)" type="image/avif" srcset={heroSet('phone', 'avif')} sizes="100vw" width="900" height="1613" />
        <source media="(max-width: 47.99rem)" type="image/webp" srcset={heroSet('phone', 'webp')} sizes="100vw" width="900" height="1613" />
        <source type="image/avif" srcset={heroSet('desktop', 'avif')} sizes="100vw" />
        <img class="hero-photo" src="/images/photos/e4-trail-map-desktop.webp" srcset={heroSet('desktop', 'webp')} sizes="100vw" alt="A hiker seen from behind holds a scribbled trail map and looks up a misty forest trail toward a mountain" width="2000" height="1116" fetchpriority="high" />
      </picture>
      <div class="wrap hero-copy">
        <h1 class="kicker"><span class="va">Virginia</span> Workers’ Comp Lawyer</h1>
        <p class="hero-big">Hurt at work?<br /><span class="hand">We’ve got this.</span></p>
        <p class="hero-lede">Workers’ comp is all we do. Free consultation. Zero pressure.</p>
        <div class="hero-acts">
          <a class="btn btn-primary btn-call" href={site.phoneHref}>Call {site.phoneDisplay}</a>
          <a class="tl" href="#contact">Or send us a message</a>
        </div>
      </div>
    </section>

    <!-- Big band, right under the hero (Bryn, Nov 3): the eye goes left in the hero, right here, then back to the middle. -->
    <section class="e4-band">
      <Photo class="band-bg" src="/images/photos/e4-green-ridges-gold-sky.jpg" alt="" width="2000" height="1333" sizes="100vw" loading="lazy" defer />
      <div class="wrap">
        <svg class="doodle compass compass-band" viewBox="0 0 120 130" aria-hidden="true"><path d={doodle.compassRing} /><path class="dots" d={doodle.compassDots} /><path class="needle" transform="rotate(28 60 70)" d={doodle.needle} /></svg>
        <p class="big">All we do is workers’ comp.</p>
        <p class="sub">Not wills. Not divorces. Just helping people <span class="typer" data-typer={bandPhrases.join('|')} data-end=".">hurt at work.</span></p>
      </div>
    </section>

    <!-- What happens when you call: field notes, with one thin trail line behind the four steps. -->
    <section class="e4-steps map map-1">
      <div class="wrap">
        <p class="k">Field notes</p>
        <h2 class="e4-h">What happens when you call</h2>
        <div class="cards">
          <svg class="trail" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 44C120 44 180 20 300 22S480 50 600 46S780 14 900 18S1080 46 1200 34" /></svg>
          <svg class="doodle biker" viewBox="0 0 64 46" aria-hidden="true"><path d={doodle.biker} /></svg>
          <ol class="card-list">
            {steps.map((s, i) => (
              <li class="card">
                <span class="num" aria-hidden="true">Note {i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}{s.link && <> <a class="tl" href={s.link.href}>{s.link.label}</a></>}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- How we help: the photos as field-guide plates (corner crop marks and a Fig. label). -->
    <section class="e4-help dark">
      <div class="wrap">
        <p class="k">How we help</p>
        <h2 class="e4-h">Wherever your claim stands</h2>
        <div class="help-row">
          {help.map((h, i) => (
            <a class="help-card" href={h.href}>
              <span class="ph plate">
                <i class="crop" aria-hidden="true"></i>
                {i === 1 && <svg class="doodle bird" viewBox="0 0 40 32" aria-hidden="true"><path d={doodle.bird} /></svg>}
                <Photo src={h.img} alt="" width="1000" height="1000" sizes="(min-width: 48rem) 380px, 90vw" loading="lazy" defer />
              </span>
              <p class="fig" aria-hidden="true">Fig. {i + 1}</p>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </a>
          ))}
        </div>
        <ul class="topic-links">
          {topics.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
        </ul>
      </div>
    </section>

    <!-- Client comments, further down the page now (Bryn, Nov 3). The yeti peeks over card 3. -->
    <section class="e4-quotes map map-2 dark">
      <div class="wrap">
        <h2 class="e4-h">What our clients say</h2>
        <div class="notes">
          {reviews.map((r, i) => (
            <figure class="note">
              {i === 2 && <svg class="doodle yeti" viewBox="0 0 64 42" aria-hidden="true"><path d={doodle.yeti} /></svg>}
              <svg class="stars" viewBox="0 0 118 22" role="img" aria-label="5 star review"><g>{[0, 1, 2, 3, 4].map((i) => <path transform={`translate(${i * 24} 0)`} d="M11 2l2.6 6 6.4.5-4.9 4.2 1.5 6.3L11 15.6 5.4 19l1.5-6.3L2 8.5l6.4-.5z" />)}</g></svg>
              <blockquote><p>“{r.text}”</p></blockquote>
              <figcaption>{r.by}</figcaption>
            </figure>
          ))}
        </div>
        <p class="fine">These comments are from past clients. Each case is different, and these comments do not promise or predict a result in yours.</p>
        <a class="tl" href="/reviews/">Read more reviews</a>
      </div>
    </section>

    <!-- Results: map lines at full (still light) strength. No doodles near results or their disclaimer. -->
    <section class="e4-results map map-3">
      <div class="wrap">
        <p class="k">Results</p>
        <h2 class="e4-h">Some of our clients’ settlements</h2>
        <div class="rgrid">
          {results.map((r) => (
            <article>
              <p class="amount">{r.amount}</p>
              <p>{r.href ? <>{r.text.split(r.linkText!)[0]}<a href={r.href}>{r.linkText}</a>{r.text.split(r.linkText!).slice(1).join(r.linkText!)}</> : r.text}</p>
            </article>
          ))}
        </div>
        <p class="fine">Amounts shown are gross, before attorney’s fees, costs, and liens. Every case is different. These results depended on facts unique to each case and do not predict or guarantee the result in yours.</p>
        <a class="tl" href="/results/">View more case results</a>
      </div>
    </section>

    <!-- Meet us, with the who-we-are text from the Nov 1 SEO rewrite. -->
    <section class="e4-us map map-3 dark">
      <div class="wrap">
        <p class="k">Meet us</p>
        <h2 class="e4-h">Two people. One kind of case.</h2>
        <div class="us-text">
          <p>
            <strong>Pathfinder Injury Law</strong> is a family-owned workers’ compensation law firm in
            Richmond, Virginia. We handle only Virginia workers’ comp claims, and only for people who get
            hurt at work. Our offices are in <a href="/richmond-workers-comp-lawyer/">Richmond</a> and in
            Chincoteague on the <a href="/eastern-shore-workers-comp-lawyer/">Eastern Shore</a>, and we
            take cases from every part of the state, by phone or video if that’s easier.
          </p>
          <p>
            Most people call us with the same few questions: <a href="/virginia-workers-comp-lawyer/">what
            Virginia workers’ comp pays</a>, <a href="/how-to-file-a-workers-comp-claim/">how to file a
            claim</a>, and <a href="/how-to-appeal-a-workers-comp-denial-in-virginia/">what to do when the
            insurance company says no</a>. Quick answers are in our
            <a href="/virginia-workers-comp-faq/">workers’ comp FAQ</a>. Your first consultation is free.
          </p>
        </div>
        <div class="pair">
          <a class="person" href="/bryn-swartz/">
            <span class="ph">
              <svg class="doodle sun" viewBox="0 0 60 60" aria-hidden="true"><path d={doodle.sun} /></svg>
              <Photo src="/images/photos/bryn.jpg" alt="Bryn Swartz" width="900" height="900" sizes="(min-width: 48rem) 560px, 90vw" loading="lazy" />
            </span>
            <h3>Bryn Swartz</h3>
            <p class="role">Owner/Attorney</p>
          </a>
          <a class="person" href="/mandy-truman/">
            <span class="ph"><Photo src="/images/photos/mandy.jpg" alt="Mandy Truman" width="900" height="900" sizes="(min-width: 48rem) 560px, 90vw" loading="lazy" /></span>
            <h3>Mandy Truman</h3>
            <p class="role">Firm Administrator</p>
          </a>
        </div>
      </div>
    </section>

    <!-- The one form on this page (id="contact"), in a map-only frame: a dotted trail from the compass under the headline to an X by the form (drawn by the script below). -->
    <section class="e4-contact map map-4 dark">
      <div class="wrap contact-grid">
        <svg class="route-link" aria-hidden="true" focusable="false"><path class="route" /><path class="x" /></svg>
        <div class="talk">
          <h2 class="e4-h">Let’s talk about <span class="typer typer-block" data-typer={formPhrases.join('|')} data-end=".">what happened.</span></h2>
          <svg class="camp compass" viewBox="0 0 120 130" aria-hidden="true"><path d={doodle.compassRing} /><path class="dots" d={doodle.compassDots} /><path class="needle" transform="rotate(70 60 70)" d={doodle.needle} /></svg>
        </div>
        <div class="form-bare" id="contact">
          <ContactForm namePlaceholder="What’s your name?" />
        </div>
      </div>
    </section>

  </div>

  <script>
    // 1) Rotating type-outs ([data-typer]). The HTML already holds one complete sentence. Here the last phrase is
    //    typed out and swapped. Screen readers keep reading that original sentence. Nothing runs for visitors who
    //    ask for reduced motion, so they see the static sentence. The box is sized to the longest phrase first, and
    //    the caret and the full stop slide along by transform (not by layout), so nothing moves while it types.
    // 0) The band and help photos are held back (Photo "defer") so only the hero loads first on phones. Each one
    //    gets its real URLs back when it comes within 400px of the screen. This runs for every visitor.
    const wake = (p: Element) => {
      p.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((s) => { s.srcset = s.dataset.srcset!; s.removeAttribute('data-srcset'); });
      const img = p.querySelector<HTMLImageElement>('img[data-src]');
      if (img) { img.src = img.dataset.src!; img.removeAttribute('data-src'); }
      p.removeAttribute('data-defer');
    };
    const held = document.querySelectorAll('picture[data-defer]');
    if ('IntersectionObserver' in window) {
      // Watch the img: the picture element is display: contents, so it has no box of its own.
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); wake(e.target.closest('picture')!); } }), { rootMargin: '400px 0px' });
      held.forEach((p) => { const img = p.querySelector('img'); if (img) io.observe(img); else wake(p); });
    } else held.forEach(wake);

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!calm) {
      document.querySelectorAll<HTMLElement>('[data-typer]').forEach((el) => {
        const end = el.dataset.end ?? '';
        const phrases = (el.dataset.typer ?? '').split('|').filter(Boolean);
        if (phrases.length < 2) return;
        const reader = document.createElement('span');
        reader.className = 'visually-hidden';
        reader.textContent = el.textContent ?? '';
        const live = document.createElement('span');
        live.setAttribute('aria-hidden', 'true');
        const text = document.createTextNode(phrases[0]);
        live.append(text);
        const caret = document.createElement('span');
        caret.className = 'typer-caret';
        caret.setAttribute('aria-hidden', 'true');
        const dot = document.createElement('span');
        dot.className = 'typer-dot';
        dot.setAttribute('aria-hidden', 'true');
        dot.textContent = end;
        el.textContent = '';
        el.append(reader, live, caret, dot);

        // Put the caret and the full stop just after the last typed letter.
        const place = () => {
          const range = document.createRange();
          range.setStart(text, text.length);
          range.collapse(true);
          const r = range.getClientRects()[0];
          const b = el.getBoundingClientRect();
          const x = r ? r.left - b.left : 0;
          const y = r ? r.top - b.top : 0;
          caret.style.transform = `translate(${x}px, ${y}px)`;
          dot.style.transform = `translate(${x + caret.offsetWidth + 1}px, ${y}px)`;
        };
        // Size the box to the longest phrase at the current width.
        const reserve = () => {
          const keep = text.data;
          el.style.minWidth = '';
          el.style.minHeight = '';
          let w = 0, h = 0;
          for (const ph of phrases) {
            text.data = ph;
            const r = el.getBoundingClientRect();
            w = Math.max(w, r.width);
            h = Math.max(h, r.height);
          }
          text.data = keep;
          el.style.minHeight = h + 'px';
          if (!el.classList.contains('typer-block')) el.style.minWidth = w + 'px';
          place();
        };
        let timer = 0, i = 0, seen = false, shown = true;
        const later = (fn: () => void, ms: number) => { timer = window.setTimeout(fn, ms); };
        const typeIn = (n: number) => {
          const ph = phrases[i];
          text.data = ph.slice(0, n) || '\u200b'; // a zero-width space keeps a caret position when empty
          place();
          if (n < ph.length) later(() => typeIn(n + 1), 55 + Math.random() * 35);
          else later(() => eraseOut(ph.length), 2400);
        };
        const eraseOut = (n: number) => {
          text.data = phrases[i].slice(0, n) || '\u200b';
          place();
          if (n > 0) later(() => eraseOut(n - 1), 24);
          else { i = (i + 1) % phrases.length; later(() => typeIn(0), 260); }
        };
        const run = () => { window.clearTimeout(timer); if (seen && shown && !document.hidden) later(() => eraseOut(phrases[i].length), 2400); };
        new IntersectionObserver((e) => { seen = e[0].isIntersecting; if (seen) run(); else window.clearTimeout(timer); }).observe(el);
        document.addEventListener('visibilitychange', () => { shown = !document.hidden; if (shown) run(); else window.clearTimeout(timer); });
        document.fonts?.ready.then(reserve);
        let rz = 0;
        window.addEventListener('resize', () => { window.clearTimeout(rz); rz = window.setTimeout(() => { window.clearTimeout(timer); reserve(); run(); }, 160); });
        place();
      });
    }

    // 2) The dotted trail in the contact section: from the compass under the headline to an X beside the first
    //    field of the form. It is drawn from the real positions each time the layout changes, so it always connects.
    const grid = document.querySelector<HTMLElement>('.contact-grid');
    const svg = grid?.querySelector<SVGSVGElement>('.route-link');
    const camp = grid?.querySelector<SVGSVGElement>('.camp');
    const form = grid?.querySelector<HTMLElement>('.form-bare');
    if (grid && svg && camp && form) {
      const route = svg.querySelector('.route')!;
      const x = svg.querySelector('.x')!;
      const needle = camp.querySelector('.needle');
      let raf = 0;
      const draw = () => {
        raf = 0;
        const g = grid.getBoundingClientRect();
        const c = camp.getBoundingClientRect();
        const field = form.querySelector<HTMLElement>('.step:not([hidden]) :is(input, textarea, select, button)') ?? form;
        const f = field.getBoundingClientRect();
        const sx = c.right - g.left + 10;
        const sy = c.top - g.top + c.height * 0.55;
        const side = f.left - c.right > 140; // form beside the compass (wide) or under it (phones, tablets)
        const ex = side ? f.left - g.left - 34 : f.left - g.left + f.width * 0.72;
        const ey = side ? f.top - g.top + Math.min(f.height / 2, 34) : f.top - g.top - 30;
        const dx = ex - sx, dy = ey - sy;
        // stop the dots a little short of the X
        const tx = side ? ex - 14 : ex, ty = side ? ey : ey - 14;
        route.setAttribute('d', side
          ? `M${sx} ${sy} C${sx + dx * 0.4} ${sy + 34}, ${tx - dx * 0.3} ${ty + 50}, ${tx} ${ty}`
          : `M${sx} ${sy} C${sx + (tx - sx) * 0.6} ${sy + 4}, ${tx} ${ty - (ty - sy) * 0.6}, ${tx} ${ty}`);
        x.setAttribute('d', `M${ex - 8} ${ey - 8}L${ex + 8} ${ey + 8}M${ex + 8} ${ey - 8}L${ex - 8} ${ey + 8}`);
        // Turn the compass needle to point at the X (0 degrees is straight up).
        const cx = c.left - g.left + c.width / 2, cy = c.top - g.top + c.height * (70 / 130);
        const deg = Math.atan2(ex - cx, cy - ey) * 180 / Math.PI;
        needle?.setAttribute('transform', `rotate(${deg.toFixed(1)} 60 70)`);
      };
      const soon = () => { if (!raf) raf = requestAnimationFrame(draw); };
      new ResizeObserver(soon).observe(grid);
      new ResizeObserver(soon).observe(form);
      new MutationObserver(soon).observe(form, { subtree: true, attributes: true, attributeFilter: ['hidden'] });
      window.addEventListener('resize', soon);
      document.fonts?.ready.then(soon);
      soon();
    }
  </script>

  .e4 .rgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.75rem; margin-top: 2.5rem; }
  .e4 .rgrid article { border-top: 4px solid var(--amber); padding-top: 1rem; }
  .e4 .dood { display: block; width: 58px; height: 74px; margin-bottom: 0.6rem; fill: none; stroke: var(--amber); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .e4 .amount { font-size: 2.5rem; font-weight: 900; letter-spacing: -0.02em; margin: 0 0 0.4rem; color: var(--forest); }
  .e4 .rgrid p:not(.amount) { font-size: 1rem; margin: 0; color: #3d5546; }

---
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import variants from '../data/imageVariants.json';
import { site } from '../data/site';

// Home page, design E4 (Nov 2, 2026), wilderness-to-map version (outside review, 11-02-26).
// One idea top to bottom: a real wilderness photo up top, faint map contour lines taking over as you
// scroll, and the form inside a map at the end, where the trail stops at an X. Rules: one art layer
// per section (a photo or map lines, never both), the map stays behind things, and about five small
// single-line doodles at the edges. No doodles in the hero, in Results, or near any disclaimer.
// "We've got this." is the page's only handwriting. Everything is inline SVG or CSS, no script.
// The search text and links from the Nov 1 SEO rewrite are kept (intro paragraphs, topic links, results links).

const heroSet = (crop: 'desktop' | 'phone', fmt: 'avif' | 'webp') =>
  (variants as any)[`/images/photos/e4-overlook-${crop}.webp`][fmt].map((v: { url: string; width: number }) => `${v.url} ${v.width}w`).join(', ');

const title = "Pathfinder Injury Law | Virginia Workers' Comp Lawyer";
const description =
  "Pathfinder Injury Law handles only Virginia workers' comp, only for injured workers. Offices in Richmond and Chincoteague. Free consultation: 804-505-0633.";

// Word for word from /reviews/ (initials only, as there). No results or comparisons (LEO 1750 section G).
const reviews = [
  { by: 'M.W.', text: 'They guided the way when I needed help the most. Very knowledgeable, respectful of my situation and always there whenever I had questions.' },
  { by: 'T.B.', text: 'The team at Pathfinders was very professional, attentive and knowledgeable. Mr. Swartz made certain that I understood my rights and walked me through the process.' },
  { by: 'K.W.', text: 'Pathfinder Injury Law was extremely helpful, knowledgeable, personable, and ensured that I understood each step of the process.' },
];

// Bryn's own steps (Nov 2), legal-checked. Step 3 is his reworded line after the check.
const steps = [
  { title: 'Free consultation', text: 'We discuss your case in a free, no-pressure consultation with Bryn, Mandy, or both.' },
  { title: 'We do our homework', text: 'We research any issues and figure out if we can help. We make sure there are no conflicts of interest or other problems.' },
  { title: 'Good fit or not', text: 'If it’s a good fit, we offer to help. If not, we tell you why. We’ll point you to another lawyer if we know someone who might be able to help.' },
  { title: 'We get to work', text: 'Paperwork is signed and we get to work.', link: { href: '/what-happens-when-you-file-a-workers-comp-claim/', label: 'How filing a claim works' } },
];

const help = [
  { title: 'Starting a claim', text: 'Just got hurt? Here’s what to do first.', href: '/how-to-file-a-workers-comp-claim/', img: '/images/photos/e4-farm-road.jpg' },
  { title: 'Denied claims', text: 'A denial isn’t the end. Here’s how appeals work.', href: '/how-to-appeal-a-workers-comp-denial-in-virginia/', img: '/images/photos/e4-autumn-ridges.jpg' },
  { title: 'Settlements', text: 'What a settlement covers, and what it closes.', href: '/workers-comp-settlement-in-virginia/', img: '/images/photos/e4-green-valley.jpg' },
];

const topics = [
  { label: 'What Virginia workers’ comp pays', href: '/virginia-workers-comp-lawyer/' },
  { label: 'Construction accidents', href: '/virginia-construction-accident-lawyer/' },
  { label: 'Factory accidents', href: '/virginia-factory-accident-lawyer/' },
  { label: 'Vehicle accidents', href: '/car-accident-at-work-in-virginia/' },
  { label: 'Back injuries', href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/' },
  { label: 'Workers’ comp FAQ', href: '/virginia-workers-comp-faq/' },
];

// Same wording and links as before the redesign (legal-checked).
const results = [
  {
    amount: '$1,200,000',
    text: 'Settlement obtained in a heavily contested ankle injury case with bodywide CRPS involvement and multiple compensable consequences following a mediation before the Virginia Workers’ Compensation Commission.',
    linkText: 'ankle injury',
    href: '/ankle-injury-workers-comp/',
  },
  {
    amount: '$360,000',
    text: 'Settlement obtained in a Virginia Workers’ Compensation case involving a back injury 10 years prior.',
    linkText: 'back injury',
    href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/',
  },
  {
    amount: '$250,000',
    text: 'Settlement obtained in a contested concussion/brain injury Workers’ Compensation case with psychosomatic issues following mediation before the Virginia Workers’ Compensation Commission.',
  },
  {
    amount: '$240,000',
    text: 'Settlement obtained in a lumbar herniation case before the Virginia Workers’ Compensation Commission.',
    linkText: 'lumbar herniation',
    href: '/what-should-you-do-if-you-have-a-spine-injury-at-work/',
  },
];

// The doodles: one line weight, rounded ends, no fill, one ink color per background (set in CSS).
// None may suggest a win (no trophies, flags, money or summit poses).
const doodle = {
  // peeking over the top edge of a quote card: shaggy head, two eyes, fingers on the edge
  yeti: 'M12 42C12 22 21 12 32 12S52 22 52 42M27 13C27 9 29 7 31 6M33 12C34 9 36 8 38 8M21 42C21 31 26 25 32 25S43 31 43 42M28 32m-1.3 0a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0-2.6 0M36 32m-1.3 0a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0-2.6 0M29.5 37q2.5 1.6 5 0M2 42q2-5 4 0q2-5 4 0q2-5 4 0M50 42q2-5 4 0q2-5 4 0q2-5 4 0',
  // riding the trail line
  biker: 'M14 36m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0M50 36m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0M14 36H28L22 24M28 36L42 22L50 36M22 24H42M42 22L40 17H45M18 22H25M40 8m-3.5 0a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0M38 12L25 21M36 14L42 18M25 21L32 28L28 35',
  // perched on the top edge of a photo
  bird: 'M27 10m-5.5 0a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0M32.5 9L37 10.5L32 12M28.5 9m-0.6 0a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0-1.2 0M22.5 13.5C27 17 26 25 17 25C12 25 8 22 3 19C9 19 13 14 22.5 13.5M11 19C15 21 19 20 21 17M15 25V30M19 25V30M13 30H17M17 30H21',
  // tucked behind a photo corner
  sun: 'M30 30m-10 0a10 10 0 1 0 20 0a10 10 0 1 0-20 0M30 15V8M30 52V45M15 30H8M52 30H45M19.4 19.4L14.4 14.4M45.6 45.6L40.6 40.6M40.6 19.4L45.6 14.4M14.4 45.6L19.4 40.6',
  // tent and campfire by the X at the end of the trail
  camp: 'M96 116H190M104 116L127 80L150 116M121 116L127 103L133 116M127 80l-3-6M127 80l3-6M162 116L184 109M162 109L184 116M173 107C167 101 170 95 173 88C176 95 179 101 173 107',
};
---
<Base
  title={title}
  description={description}
  path="/"
  datePublished="2022-02-25T23:07:43+00:00"
  overlay
  heroLight
>
  <Fragment slot="head">
    <!-- Start the hero photo download right away, in the size and format the browser will pick below. -->
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroSet('desktop', 'avif')} imagesizes="100vw" media="(min-width: 48rem)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroSet('phone', 'avif')} imagesizes="100vw" media="(max-width: 47.99rem)" fetchpriority="high" />
    <!-- Bryn's handwriting is in the headline, so fetch it early: a late swap would rewrap the hero (layout shift). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/kbs-handwriting.woff2" crossorigin />
  </Fragment>

  <div class="e4">
    <!-- Hero: one real photo edge to edge, words low left. -->
    <section class="hero hero-e4">
      <picture class="hero-pic">
        <source media="(max-width: 47.99rem)" type="image/avif" srcset={heroSet('phone', 'avif')} sizes="100vw" width="900" height="1452" />
        <source media="(max-width: 47.99rem)" type="image/webp" srcset={heroSet('phone', 'webp')} sizes="100vw" width="900" height="1452" />
        <source type="image/avif" srcset={heroSet('desktop', 'avif')} sizes="100vw" />
        <img class="hero-photo" src="/images/photos/e4-overlook-desktop.webp" srcset={heroSet('desktop', 'webp')} sizes="100vw" alt="A hiker standing on a rocky overlook above a wide valley" width="2000" height="1333" fetchpriority="high" />
      </picture>
      <div class="wrap hero-copy">
        <h1 class="kicker">Virginia Workers’ Comp Lawyer</h1>
        <p class="hero-big">Hurt at work?<br /><span class="hand">We’ve got this.</span></p>
        <p class="hero-lede">Workers’ comp is all we do. Free consultation. Zero pressure.</p>
        <div class="hero-acts">
          <a class="btn btn-primary btn-call" href={site.phoneHref}>Call {site.phoneDisplay}</a>
          <a class="tl" href="#contact">Or send us a message</a>
        </div>
      </div>
    </section>

    <!-- Client comments. A ridge line closes the hero photo; the first faint map lines start here. -->
    <section class="e4-quotes map map-1 dark">
      <svg class="ridge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V52L70 30L120 44L210 8L290 40L350 26L430 50L520 18L600 42L690 22L780 46L860 14L950 40L1030 28L1120 50L1200 20L1290 44L1360 32L1440 46V80Z" /></svg>
      <div class="wrap">
        <h2 class="e4-h">What our clients say</h2>
        <div class="notes">
          {reviews.map((r, i) => (
            <figure class="note">
              {i === 2 && <svg class="doodle yeti" viewBox="0 0 64 42" aria-hidden="true"><path d={doodle.yeti} /></svg>}
              <svg class="stars" viewBox="0 0 118 22" role="img" aria-label="5 star review"><g>{[0, 1, 2, 3, 4].map((i) => <path transform={`translate(${i * 24} 0)`} d="M11 2l2.6 6 6.4.5-4.9 4.2 1.5 6.3L11 15.6 5.4 19l1.5-6.3L2 8.5l6.4-.5z" />)}</g></svg>
              <blockquote><p>“{r.text}”</p></blockquote>
              <figcaption>{r.by}</figcaption>
            </figure>
          ))}
        </div>
        <p class="fine">These comments are from past clients. Each case is different, and these comments do not promise or predict a result in yours.</p>
        <a class="tl" href="/reviews/">Read more reviews</a>
      </div>
    </section>

    <!-- What happens when you call: one thin trail line behind the four steps. -->
    <section class="e4-steps map map-2">
      <div class="wrap">
        <p class="k">Your trail</p>
        <h2 class="e4-h">What happens when you call</h2>
        <div class="cards">
          <svg class="trail" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 44C120 44 180 20 300 22S480 50 600 46S780 14 900 18S1080 46 1200 34" /></svg>
          <svg class="doodle biker" viewBox="0 0 64 46" aria-hidden="true"><path d={doodle.biker} /></svg>
          <ol class="card-list">
            {steps.map((s, i) => (
              <li class="card">
                <span class="num">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}{s.link && <> <a class="tl" href={s.link.href}>{s.link.label}</a></>}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- How we help: plain photos, the last wilderness views. -->
    <section class="e4-help dark">
      <div class="wrap">
        <p class="k">How we help</p>
        <h2 class="e4-h">Wherever your claim stands</h2>
        <div class="help-row">
          {help.map((h, i) => (
            <a class="help-card" href={h.href}>
              <span class="ph">
                {i === 1 && <svg class="doodle bird" viewBox="0 0 40 32" aria-hidden="true"><path d={doodle.bird} /></svg>}
                <Photo src={h.img} alt="" width="1000" height="1000" sizes="(min-width: 48rem) 380px, 90vw" loading="lazy" />
              </span>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </a>
          ))}
        </div>
        <ul class="topic-links">
          {topics.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
        </ul>
      </div>
    </section>

    <!-- Big band: the last full photo on the page. -->
    <section class="e4-band">
      <Photo class="band-bg" src="/images/photos/e4-green-ridges-gold-sky.jpg" alt="" width="2000" height="1333" sizes="100vw" loading="lazy" />
      <div class="wrap">
        <p class="big">All we do is workers’ comp.</p>
        <p class="sub">Not wills. Not divorces. Just helping people hurt at work.</p>
      </div>
    </section>

    <!-- Results: map lines at full (still light) strength. No doodles near results or their disclaimer. -->
    <section class="e4-results map map-3">
      <div class="wrap">
        <p class="k">Results</p>
        <h2 class="e4-h">Some of our clients’ settlements</h2>
        <div class="rgrid">
          {results.map((r) => (
            <article>
              <p class="amount">{r.amount}</p>
              <p>{r.href ? <>{r.text.split(r.linkText!)[0]}<a href={r.href}>{r.linkText}</a>{r.text.split(r.linkText!).slice(1).join(r.linkText!)}</> : r.text}</p>
            </article>
          ))}
        </div>
        <p class="fine">Amounts shown are gross, before attorney’s fees, costs, and liens. Every case is different. These results depended on facts unique to each case and do not predict or guarantee the result in yours.</p>
        <a class="tl" href="/results/">View more case results</a>
      </div>
    </section>

    <!-- Meet us, with the who-we-are text from the Nov 1 SEO rewrite. -->
    <section class="e4-us map map-3 dark">
      <div class="wrap">
        <p class="k">Meet us</p>
        <h2 class="e4-h">Two people. One kind of case.</h2>
        <div class="us-text">
          <p>
            <strong>Pathfinder Injury Law</strong> is a family-owned workers’ compensation law firm in
            Richmond, Virginia. We handle only Virginia workers’ comp claims, and only for people who get
            hurt at work. Our offices are in <a href="/richmond-workers-comp-lawyer/">Richmond</a> and in
            Chincoteague on the <a href="/eastern-shore-workers-comp-lawyer/">Eastern Shore</a>, and we
            take cases from every part of the state, by phone or video if that’s easier.
          </p>
          <p>
            Most people call us with the same few questions: <a href="/virginia-workers-comp-lawyer/">what
            Virginia workers’ comp pays</a>, <a href="/how-to-file-a-workers-comp-claim/">how to file a
            claim</a>, and <a href="/how-to-appeal-a-workers-comp-denial-in-virginia/">what to do when the
            insurance company says no</a>. Quick answers are in our
            <a href="/virginia-workers-comp-faq/">workers’ comp FAQ</a>. Your first consultation is free.
          </p>
        </div>
        <div class="pair">
          <a class="person" href="/bryn-swartz/">
            <span class="ph">
              <svg class="doodle sun" viewBox="0 0 60 60" aria-hidden="true"><path d={doodle.sun} /></svg>
              <Photo src="/images/photos/bryn.jpg" alt="Bryn Swartz" width="900" height="900" sizes="(min-width: 48rem) 560px, 90vw" loading="lazy" />
            </span>
            <h3>Bryn Swartz</h3>
            <p class="role">Owner/Attorney</p>
          </a>
          <a class="person" href="/mandy-truman/">
            <span class="ph"><Photo src="/images/photos/mandy.jpg" alt="Mandy Truman" width="900" height="900" sizes="(min-width: 48rem) 560px, 90vw" loading="lazy" /></span>
            <h3>Mandy Truman</h3>
            <p class="role">Firm Administrator</p>
          </a>
        </div>
      </div>
    </section>

    <!-- The one form on this page (id="contact"), in a map-only frame: the trail ends at an X by the form. -->
    <section class="e4-contact map map-4 dark">
      <div class="wrap contact-grid">
        <div class="talk">
          <h2 class="e4-h">Let’s talk about what happened.</h2>
          <svg class="camp" viewBox="0 0 260 120" aria-hidden="true">
            <path class="route" d="M4 10C40 30 30 70 80 74S150 40 196 70" />
            <path class="x" d="M196 62L212 78M212 62L196 78" />
            <path class="ink" d={doodle.camp} />
          </svg>
        </div>
        <div class="form-bare" id="contact">
          <ContactForm namePlaceholder="What’s your name?" />
        </div>
      </div>
    </section>

    <!-- Sketched map, west to east: Blue Ridge, Richmond, the Bay, the Eastern Shore, the Atlantic. -->
    <div class="mapfoot">
      <svg viewBox="0 0 1440 190" preserveAspectRatio="xMidYMax meet" role="img" aria-label="Map sketch: mountains in western Virginia, Richmond in the middle, and the Eastern Shore by the ocean">
        <g fill="none" stroke="#a7c18a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M0 132L52 84L84 108L146 46L196 96L238 70L292 112L344 86L398 124L452 140" />
          <path d="M0 156L64 118L110 142L182 98L248 144L318 120L386 150L452 152" />
          <path d="M146 46L134 66M146 46L158 64M146 46L148 70M238 70L230 84M238 70L246 84M182 98L174 112M182 98L190 112" />
          <path d="M412 150L424 118L436 150ZM416 136H432M440 152L450 128L460 152Z" />
          <path d="M260 170C340 176 420 164 500 170S640 178 720 170S860 166 930 172" stroke-dasharray="1 9" stroke-width="3" />
          <path d="M452 152C520 146 590 150 660 148S800 144 900 152" />
          <path d="M520 162H560M580 164H630M700 162H760M780 160H830" stroke-width="1.6" />
          <path d="M548 146V132M548 132a8 8 0 1 0 0.1 0ZM604 147V135M604 135a6 6 0 1 0 0.1 0ZM770 145V131M770 131a8 8 0 1 0 0.1 0ZM806 147V137M806 137a5 5 0 1 0 0.1 0Z" />
          <path d="M662 132L678 148M678 132L662 148" stroke="#ffd040" stroke-width="3.4" />
          <path d="M920 160q10-7 20 0t20 0t20 0t20 0M940 174q10-7 20 0t20 0t20 0M1000 146q10-7 20 0t20 0" stroke-width="1.8" />
          <path d="M1060 156C1100 140 1180 136 1250 142C1280 145 1300 150 1312 156" />
          <path d="M1252 150C1272 152 1292 156 1312 162" stroke-dasharray="1 7" stroke-width="2.6" />
          <path d="M1096 146l-4-12M1100 146l2-14M1104 146l6-10M1214 140l-4-12M1218 140l2-14M1222 140l6-10" />
          <path d="M1140 132L1156 148M1156 132L1140 148" stroke="#ffd040" stroke-width="3.4" />
          <path d="M1262 142L1266 100H1278L1282 142ZM1264 128H1280M1265 114H1279M1268 100L1272 92L1276 100" />
          <path d="M1330 158q10-7 20 0t20 0t20 0t20 0t20 0M1350 174q10-7 20 0t20 0t20 0t20 0" stroke-width="1.8" />
          <path d="M1352 144A34 34 0 0 1 1420 144M1386 98V86M1358 110L1350 102M1414 110L1422 102M1342 128L1332 124M1430 128L1440 124" stroke="#ffd040" />
        </g>
        <g class="map-labels" fill="#e9efdf" font-size="30">
          <text x="132" y="30">Blue Ridge</text>
          <text x="622" y="118">Richmond</text>
          <text x="1080" y="112">Eastern Shore</text>
        </g>
      </svg>
    </div>
  </div>
</Base>

<style is:global>
  /* ===== Home page, design E4. Scoped by .e4 (and body:has(.e4) for the shared header). ===== */
  .e4 {
    --sage-e4: #e9efdf;
    --cream: #fff5d5;
    --act-e4: #a15b00; /* darker Brand Book orange shade, 5.23:1 with white text */
    background: var(--sage-e4);
  }
  /* Bryn's own handwriting, made on Calligraphr (his property, per Calligraphr's FAQ). One weight only,
     so the notes stay at 400 with no faux bold. */
  @font-face {
    font-family: 'Kbs Handwriting';
    font-display: swap;
    src: url('/fonts/kbs-handwriting.woff2') format('woff2'); /* subset by scripts/make-handwriting-font.mjs */
  }
  .e4 .k { font-weight: 800; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--moss); margin: 0 0 0.75rem; }
  .e4 .dark .k { color: var(--sun); }
  .e4 .e4-h { font-size: clamp(2.125rem, 4vw, 3.25rem); line-height: 1.05; font-weight: 900; letter-spacing: -0.02em; margin: 0; }
  .e4 .dark .e4-h { color: var(--cream); }
  .e4 .tl { font-weight: 700; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; text-decoration-color: var(--sun); color: inherit; }
  .e4 .fine { font-size: 0.8125rem; margin: 1.75rem 0 0.75rem; }

  /* Header on this page: sage bar with a straight bottom edge and a bigger logo (Bryn, Nov 2).
     The padding keeps the Brand Book clear space (the x-height of the logotype) around the logo. */
  body:has(.e4) .site-header:not(.is-solid) { background: #e9efdf; box-shadow: none; }
  body:has(.e4) .site-header:not(.is-solid)::before { display: none; }
  body:has(.e4) .site-header:not(.is-solid) .brand { padding: 1rem 0; }
  body:has(.e4) .site-header:not(.is-solid) .brand img { width: 15.5rem; }
  @media (min-width: 48rem) {
    body:has(.e4) .site-header:not(.is-solid) .brand { padding: 1.5rem 0; }
    body:has(.e4) .site-header:not(.is-solid) .brand img { width: 26rem; }
  }

  /* Hero */
  .e4 .hero-e4 { --hero-top: 11rem; position: relative; min-height: 100svh; max-height: 68rem; overflow: hidden; color: #e9efdf; background: #e9efdf; display: flex; align-items: flex-end; }
  .e4 .hero-e4 .hero-pic, .e4 .hero-e4 .hero-photo { position: absolute; inset: var(--hero-top) 0 0 0; width: 100%; height: calc(100% - var(--hero-top)); object-fit: cover; object-position: 70% 0%; }
  .e4 .hero-e4 .hero-photo { inset: 0; height: 100%; }
  .e4 .hero-e4::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    -webkit-mask: none;
    mask: none;
    background:
      linear-gradient(180deg, rgba(64, 104, 60, 0) 86%, #40683c 100%),
      linear-gradient(0deg, rgba(20, 36, 27, 0.78) 0%, rgba(20, 36, 27, 0.45) 45%, rgba(20, 36, 27, 0) 70%),
      radial-gradient(ellipse 62% 60% at 20% 62%, rgba(20, 36, 27, 0.72) 0%, rgba(20, 36, 27, 0.72) 45%, rgba(20, 36, 27, 0) 100%), /* behind the words: yellow 4.3:1 at its worst spot */
      linear-gradient(90deg, rgba(20, 36, 27, 0.4), rgba(20, 36, 27, 0) 62%);
  }
  .e4 .hero-copy { position: relative; z-index: 2; padding-bottom: 4rem; }
  /* No fade-in on the home hero text: it is visible on first paint, so it can't hold back LCP. */
  .e4 .hero-copy > * { animation: none; }
  .e4 .hero-copy .kicker { font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sun); margin: 0 0 0.75rem; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55); }

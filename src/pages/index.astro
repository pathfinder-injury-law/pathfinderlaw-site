  .e4 .form-bare .form-card { background: none; box-shadow: none; padding: 0; border: 0; color: #fff; }
  .e4 .form-bare .form-card > h3 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .e4 .form-bare .step[data-step='name'] legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .e4 .e4-band picture, .e4 .e4-band .band-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .e4 .e4-band::after { content: ''; position: absolute; inset: 0; background: rgba(20, 36, 27, 0.32); }
  .e4 .e4-band .wrap { position: relative; z-index: 2; width: 100%; }
  .e4 .e4-band .big { font-size: clamp(2.5rem, 7.5vw, 6.75rem); line-height: 0.92; font-weight: 900; letter-spacing: -0.02em; text-transform: uppercase; margin: 0; max-width: 62rem; }
  .e4 .e4-band .sub { font-size: 1.375rem; margin: 1.4rem 0 0; }

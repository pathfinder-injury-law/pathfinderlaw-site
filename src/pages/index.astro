---
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import TornEdge from '../components/TornEdge.astro';
import TopicIcon from '../components/TopicIcon.astro';
import ContactSection from '../components/ContactSection.astro';
import ContactForm from '../components/ContactForm.astro';
import variants from '../data/imageVariants.json';

// Hero photo copies (scripts/make-image-variants.mjs), as srcset lists.
const heroSet = (crop: 'desktop' | 'phone', fmt: 'avif' | 'webp') =>
  (variants as any)[`/images/photos/hero-over-shoulder-${crop}.webp`][fmt].map((v: { url: string; width: number }) => `${v.url} ${v.width}w`).join(', ');

// Title, description and wording match the current live homepage, except the
// approved results wording (migration plan, Section VIII, fix 1).
const title = "Pathfinder Injury Law - Virginia Workers' Comp Lawyer";
const description =
  "At Pathfinder Injury Law, all we do is workers' comp cases. Call our dedicated law office in Richmond, Virginia at 804-505-0633 today.";

const topics = [
  { label: 'Construction Accidents', href: '/virginia-construction-accident-lawyer/', icon: 'construction' },
  { label: 'Factory Accidents', href: '/virginia-factory-accident-lawyer/', icon: 'factory' },
  { label: 'Vehicle Accidents', href: '/car-accident-at-work-in-virginia/', icon: 'vehicle' },
  { label: 'Back Injuries', href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/', icon: 'spine' },
];

const team = [
  { name: 'Bryn Swartz', role: 'Owner and Attorney', href: '/bryn-swartz/', img: '/images/photos/bryn-round.webp' },
  { name: 'Mandy Truman', role: 'Firm Administrator', href: '/mandy-truman/', img: '/images/photos/mandy-round.webp' },
];

const traits = ['Local', 'Experienced', 'Focused', 'Fighting Spirit', 'Calming Presence'];

const results = [
  {
    amount: '$1,200,000',
    count: 1200000,
    text: 'Settlement obtained in a heavily contested ankle injury case with bodywide CRPS involvement and multiple compensable consequences following a mediation before the Virginia Workers’ Compensation Commission.',
  },
  {
    amount: '$360,000',
    count: 360000,
    text: 'Settlement obtained in a Virginia Workers’ Compensation case involving a back injury 10 years prior.',
  },
  {
    amount: '$250,000',
    count: 250000,
    text: 'Settlement obtained in a contested concussion/brain injury Workers’ Compensation case with psychosomatic issues following mediation before the Virginia Workers’ Compensation Commission.',
  },
  {
    amount: '$240,000',
    count: 240000,
    text: 'Settlement obtained in a lumbar herniation case before the Virginia Workers’ Compensation Commission.',
  },
];
---
<Base
  title={title}
  description={description}
  path="/"
  datePublished="2022-02-25T23:07:43+00:00"
  overlay
  heroLight
>
  <Fragment slot="head">
    <!-- Start the hero photo download right away, in the size and format the browser will pick below.
         Browsers without AVIF skip these (type="image/avif") and find the WebP in the picture instead. -->
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroSet('desktop', 'avif')} imagesizes="100vw" media="(min-width: 48rem)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroSet('phone', 'avif')} imagesizes="100vw" media="(max-width: 47.99rem)" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin-wght-italic.woff2" crossorigin />
  </Fragment>
  <!-- Hero: words in the left two thirds over the sky, hiker in the right third. -->
  <section class="hero hero-sky">
    <!-- Art direction as before: the phone crop below 768px, the wide photo above. Each in AVIF, then WebP, in two sizes. -->
    <picture class="hero-pic">
      <source media="(max-width: 47.99rem)" type="image/avif" srcset={heroSet('phone', 'avif')} sizes="100vw" width="776" height="768" />
      <source media="(max-width: 47.99rem)" type="image/webp" srcset={heroSet('phone', 'webp')} sizes="100vw" width="776" height="768" />
      <source type="image/avif" srcset={heroSet('desktop', 'avif')} sizes="100vw" />
      <img class="hero-photo" src="/images/photos/hero-over-shoulder-desktop.webp" srcset={heroSet('desktop', 'webp')} sizes="100vw" alt="" width="1376" height="768" fetchpriority="high" />
    </picture>
    <div class="wrap">
      <div class="hero-kicker"><h1>Virginia Workers’ Comp Lawyer</h1></div>
      <span class="rule" aria-hidden="true"></span>
      <p class="hero-l1">Hurt at work?</p>
      <p class="hero-l2">Let’s go.</p>
      <div class="hero-form" id="contact">
        <ContactForm />
      </div>
      <!-- A dotted footpath from "Hurt at work?" past "Let's go." to the name question, drawn by the script below. -->
      <svg class="hero-trail" aria-hidden="true" focusable="false">
        <mask id="trail-mask" maskUnits="userSpaceOnUse"><path class="trail-reveal" /></mask>
        <path class="trail-line" mask="url(#trail-mask)" />
      </svg>
    </div>
    <script is:inline>
      // Shapes the footpath to the words: a loose loop from the end of "Hurt at work?" back to "Let's go.",
      // then down to the end of the form's first question. A slight wobble keeps it from looking machine-drawn.
      // Redrawn when the size or the fonts change. Measured with offsets, so the words' rise-in does not
      // throw it off. If anything is missing or not laid out yet, it simply draws nothing.
      (function () {
        var wrap = document.querySelector('.hero .wrap');
        var svg = wrap && wrap.querySelector('.hero-trail');
        var l1 = wrap && wrap.querySelector('.hero-l1');
        var l2 = wrap && wrap.querySelector('.hero-l2');
        var form = wrap && wrap.querySelector('.hero-form');
        var q = form && form.querySelector('.step[data-step="name"] .step-q');
        if (!svg || !l1 || !l2 || !form || !q) return;
        var line = svg.querySelector('.trail-line'), reveal = svg.querySelector('.trail-reveal');
        // Where an element's text ends (last line), in the wrap's own coordinates.
        function textEnd(el) {
          var r = document.createRange();
          r.selectNodeContents(el);
          var rects = r.getClientRects(), last = rects[rects.length - 1];
          if (!last) return null;
          var box = el.getBoundingClientRect(), x = 0, y = 0, n = el;
          while (n && n !== wrap) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent; }
          if (n !== wrap) return null;
          return { x: x + last.right - box.left, top: y + last.top - box.top, h: last.height };
        }
        function wobble(d) {
          reveal.setAttribute('d', d);
          var len = reveal.getTotalLength(), out = '', step = 4;
          for (var s = 0; s <= len; s += step) {
            var p = reveal.getPointAtLength(s), p2 = reveal.getPointAtLength(Math.min(len, s + 1)), p0 = reveal.getPointAtLength(Math.max(0, s - 1));
            var dx = p2.x - p0.x, dy = p2.y - p0.y, m = Math.sqrt(dx * dx + dy * dy) || 1;
            var o = Math.sin(s / 19) * 1.4 + Math.sin(s / 53 + 1) * 1.2;
            out += (s ? 'L' : 'M') + (p.x - (dy / m) * o).toFixed(1) + ' ' + (p.y + (dx / m) * o).toFixed(1);
          }
          return out;
        }
        function draw() {
          try {
            shape();
          } catch (e) {
            svg.style.display = 'none'; // the trail is decoration: if anything goes wrong, just leave it out
          }
        }
        function shape() {
          var a = textEnd(l1), b = textEnd(l2), c = textEnd(q);
          if (!a || !b) { line.removeAttribute('d'); reveal.removeAttribute('d'); return; }
          // After step 1 the question is hidden; the path then ends at the top of the form's panel.
          if (!c) c = { x: form.offsetLeft + Math.min(form.offsetWidth * 0.5, 160) - 12, top: form.offsetTop - 24, h: 16 };
          var w = wrap.clientWidth, gap = Math.max(8, a.h * 0.1);
          var ax = a.x + gap, ay = a.top + a.h * 0.6;
          var bx = b.x + gap, by = b.top + b.h * 0.62;
          var cx = c.x + 12, cy = c.top + c.h * 0.5;
          var room = Math.min(a.h * 1.1, w - ax - 6); // how far the loop can swing out to the right
          var d = '';
          if (room >= 30) d += 'M' + ax + ' ' + ay + 'C' + (ax + room) + ' ' + (ay + a.h * 0.05) + ' ' + (bx + room * 1.3) + ' ' + by + ' ' + bx + ' ' + by;
          else d += 'M' + bx + ' ' + by;
          // On down to the question: swing out right a little, then back in to the end of the line.
          var swing = Math.max(cx, bx) + Math.min(70, Math.max(30, w * 0.06));
          d += 'C' + swing + ' ' + (by + (cy - by) * 0.15) + ' ' + swing + ' ' + (cy - (cy - by) * 0.1) + ' ' + cx + ' ' + cy;
          var wd = wobble(d);
          line.setAttribute('d', wd);
          reveal.setAttribute('d', wd);
          reveal.style.setProperty('--trail-len', Math.ceil(line.getTotalLength()) + 1);
        }
        draw();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
        if ('ResizeObserver' in window) new ResizeObserver(draw).observe(wrap);
        else window.addEventListener('resize', draw);
      })();
    </script>
    <TornEdge fill="var(--white)" />
  </section>

  <!-- Team: two round portraits sitting on the torn edge of the hero. -->
  <section class="team-peek" aria-label="Meet your team">
    <div class="wrap">
      <ul class="peek-list">
        {team.map((p) => (
          <li>
            <a class="peek" href={p.href}>
              <img src={p.img} alt="" width="360" height="360" />
              <span class="peek-text"><strong>{p.name}</strong><span>{p.role}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="wrap intro" data-reveal>
      <div class="intro-text">
        <h2>Injured At Work?</h2>
        <hr class="rule" />
        <p class="lede lede-caps">We’ll guide you on the path to <mark>compensation.</mark></p>
        <p>
          <strong>Pathfinder Injury Law</strong> is a Worker’s Compensation law firm nestled in the
          outskirts of Richmond, Virginia, exclusively representing people who get injured in their
          workplaces. Pathfinder Injury Law takes clients from all corners of the state of Virginia.
        </p>
        <div class="btn-row">
          <a class="btn btn-dark" href="/about-us/">Learn About Our Firm</a>
        </div>
      </div>
    </div>
  </section>

  <!-- All we do -->
  <section class="section focus-band contour on-dark">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <p class="caps">All We Do Is</p>
        <h2>Workers’ Comp Law</h2>
        <hr class="rule" />
      </div>
      <div class="tiles" data-stagger>
        <a class="tile" href="/virginia-workers-comp-lawyer/">
          <Photo src="/images/photos/tile-b.jpg" alt="" width="1400" height="886" sizes="(min-width: 75rem) 588px, (min-width: 48rem) 45vw, calc(100vw - 30px)" loading="lazy" />
          <h3>Workers’ Compensation</h3>
        </a>
        <a class="tile" href="/how-to-appeal-a-workers-comp-denial-in-virginia/">
          <Photo src="/images/photos/tile-a.jpg" alt="" width="1400" height="1750" sizes="(min-width: 75rem) 588px, (min-width: 48rem) 45vw, calc(100vw - 30px)" loading="lazy" />
          <h3>Workers’ Comp Denials</h3>
        </a>
      </div>
      <ul class="topic-grid" data-stagger>
        {topics.map((t) => (
          <li>
            <a href={t.href}>
              <span class="topic-circle"><TopicIcon name={t.icon} /></span>
              <span class="topic-label">{t.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <h2>Why Choose Us?</h2>
        <hr class="rule" />
      </div>
      <div class="why" data-stagger>
        <a class="person" href="/bryn-swartz/">
          <Photo src="/images/photos/bryn.jpg" alt="" width="900" height="900" sizes="288px" loading="lazy" />
          <h3>Bryn Swartz</h3>
          <p>Founder &amp; Attorney</p>
        </a>
        <div class="traits-wrap">
          <svg class="traits-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M19 42l3-26h4l3 26z" /><path d="M20 28h8M20.8 22h6.4" /><rect x="20" y="10" width="8" height="6" rx="1" /><path d="M24 4v3M12 8l4 3M36 8l-4 3" /><path d="M15 42h18" />
          </svg>
          <hr class="rule" style="margin-inline: auto" />
          <ul class="traits">
            {traits.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <a class="person" href="/mandy-truman/">
          <Photo src="/images/photos/mandy.jpg" alt="" width="900" height="900" sizes="288px" loading="lazy" />
          <h3>Mandy Truman</h3>
          <p>Firm Administrator</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="section results contour on-dark">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Results For Our Clients</h2>
        <hr class="rule" />
      </div>
      <div class="results-grid" data-stagger>
        {results.map((r) => (
          <article class="result">
            <p class="amount" data-count={r.count}>{r.amount}</p>
            <p>{r.text}</p>
          </article>
        ))}
      </div>
      <p class="disclaimer" data-reveal>
        Amounts shown are gross, before attorney’s fees, costs, and liens. Every case is different. These results depended on facts unique to each case and do not
        predict or guarantee the result in yours.
      </p>
      <p class="more-link"><a class="btn btn-primary" href="/results/">View More Case Results</a></p>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section-sage">
    <div class="wrap review" data-reveal>
      <img class="quote-mark" src="/images/quote.svg" width="46" height="34" alt="" />
      <h2>What Our Clients Say</h2>
      <hr class="rule" />
      <p class="review-note">These comments are from past clients. Each case is different, and these comments do not promise or predict a result in yours.</p>
      <blockquote>
        <p>
          Could not ask for a better group of people to work with! Very knowledgeable and on top of
          your case. Kept me informed every step of the way and answered all of questions and
          concerns did not feel like a number very personal touch.
        </p>
      </blockquote>
      <cite>&ndash; R.A.</cite>
      <a class="btn btn-dark" href="/reviews/">Read More Reviews</a>
    </div>
  </section>

  <!-- Call to action with contact form -->
  <ContactSection variant="link" />
</Base>


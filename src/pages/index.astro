  @font-face {
    font-family: 'Kbs Handwriting';
    font-display: swap;
    src: url('/fonts/kbs-handwriting.ttf') format('truetype');
  }
  .e4 .scrawl, .e4 .note figcaption, .e4 .map-labels { font-family: 'Bradley Hand', 'Segoe Print', cursive; font-weight: 400; font-synthesis: none; }
  /* The font is only named once the page has loaded (the script adds .hand), so it never competes
     with the hero photo for bandwidth. All of this text sits below the first screen. */
  .hand .e4 .scrawl, .hand .e4 .note figcaption, .hand .e4 .map-labels { font-family: 'Kbs Handwriting', 'Bradley Hand', 'Segoe Print', cursive; }
  .e4 .ink-defs { position: absolute; }
  .e4 .ink { filter: url(#ink); }
  .e4 .k { font-weight: 800; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--moss); margin: 0 0 0.75rem; }
  .e4 .dark .k { color: var(--sun); }
  .e4 .e4-h { font-size: clamp(2.125rem, 4vw, 3.25rem); line-height: 1.05; font-weight: 900; letter-spacing: -0.02em; margin: 0; }
  .e4 .dark .e4-h { color: var(--cream); }
  .e4 .tl { font-weight: 700; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; text-decoration-color: var(--sun); color: inherit; }
  .e4 .fine { font-size: 0.8125rem; margin: 1.75rem 0 0.75rem; }
  .e4 .scrawl { line-height: 1; }

  /* Marker marks drawn by the script */
  .e4 .mk { position: relative; display: inline-block; white-space: nowrap; z-index: 0; --mc: var(--sun); }
  .e4 .mk.amber { --mc: var(--amber); }
  .e4 .mk.c { margin: 0 0.12em; }

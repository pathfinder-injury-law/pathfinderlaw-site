  .e4 .e4-contact { position: relative; padding: 7rem 0; color: #fff; }
  .e4 .e4-contact picture, .e4 .e4-contact .contact-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .e4 .e4-contact::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(41, 70, 52, 0.85), rgba(41, 70, 52, 0.4)); }

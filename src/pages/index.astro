  .e4 .hero-big { font-size: clamp(2.625rem, 6.6vw, 6.5rem); line-height: 0.92; font-weight: 900; letter-spacing: -0.025em; text-transform: uppercase; margin: 0 0 2.75rem; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25); }
  .e4 .hero-lede { font-size: 1.375rem; margin: 0 0 1.875rem; max-width: 41rem; }
  .e4 .hero-acts { display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap; }
  .e4 .btn-sun { background: var(--sun); color: var(--forest); border-color: var(--sun); letter-spacing: 0.01em; font-weight: 800; font-size: 1.125rem; padding: 0 1.75rem; }

  @media (max-width: 47.99rem) { .e4 .e4-help { padding: 4rem 0; } .e4 .dia-row { grid-template-columns: 1fr; gap: 2.25rem; } .e4 .sun { left: auto; right: 0; top: -70px; width: 84px; height: 64px; } }

  /* Band */

  body:has(.e4) .site-header:not(.is-solid)::before { display: none; }
  body:has(.e4) .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    top: 100%;
    width: 700px;
    height: 124px;
    margin-top: -1px;
    background: #e9efdf;
    clip-path: path('M0 0H700C640 0 610 20 570 56C530 96 470 118 380 122H0Z');
    pointer-events: none;
    transition: opacity 0.3s;
  }
  body:has(.e4) .site-header.is-solid::after { opacity: 0; }
  @media (min-width: 48rem) {
    body:has(.e4) .site-header:not(.is-solid) .brand img { width: 18.75rem; }
  }
  @media (max-width: 47.99rem) {

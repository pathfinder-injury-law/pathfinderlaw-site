---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactSection from '../../components/ContactSection.astro';

// All 15 results from the live page, wording unchanged. The caption under each amount and the
// "Every case is different" note are the plan's approved wording (same as the homepage).
// Owner decision (Oct 28): all results stay; the retainer agreement covers client consent.
// No client is named. Some descriptions give case details (for example "public school teacher",
// "gunshot wound"); Bryn may want to confirm those cannot identify anyone.
// Oct 31 SEO: search title and description, and a short intro above the cards. Results, captions,
// and the disclaimer are unchanged.
const title = 'Virginia Workers’ Comp Case Results | Pathfinder Injury Law';
const description =
  'Past Virginia workers’ compensation settlements in back, brain, ankle, spine, and other injury cases, most reached at mediation before the Commission.';

const results = [
  { amount: '$1,200,000', count: 1200000, text: 'Settlement obtained in a heavily contested ankle injury case with bodywide CRPS involvement and multiple compensable consequences following a mediation before the Virginia Workers’ Compensation Commission.', linkText: 'ankle injury', href: '/ankle-injury-workers-comp/' },
  { amount: '$360,000', count: 360000, text: 'Settlement obtained in a Virginia Workers’ Compensation case involving a back injury 10 years prior.', linkText: 'back injury', href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/' },
  { amount: '$250,000', count: 250000, text: 'Settlement obtained in a contested concussion/brain injury Workers’ Compensation case with psychosomatic issues following mediation before the Virginia Workers’ Compensation Commission.', linkText: 'concussion/brain injury', href: '/concussion-brain-injury-workers-comp/' },
  { amount: '$240,000', count: 240000, text: 'Settlement obtained in a lumbar herniation case before the Virginia Workers’ Compensation Commission.', linkText: 'lumbar herniation', href: '/herniated-disc-workers-comp/' },
  { amount: '$240,000', count: 240000, text: 'Settlement obtained in a 20-year-old back injury case before the Virginia Workers’ Compensation Commission.', linkText: 'back injury', href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/' },
  { amount: '$195,000', count: 195000, text: 'Settlement obtained in a contested multi-body-part case before the Virginia Workers’ Compensation Commission.' },
  { amount: '$195,000', count: 195000, text: 'Full and final settlement obtained in a slip and fall hip injury case involving a public school teacher following mediation before the Virginia Workers’ Compensation Commission.', linkText: 'hip injury', href: '/hurt-your-hip-at-work/' },
  { amount: '$175,000', count: 175000, text: 'Settlement obtained in a gunshot wound spinal injury workers’ compensation case before the Virginia Workers’ Compensation Commission.', linkText: 'spinal injury', href: '/what-should-you-do-if-you-have-a-spine-injury-at-work/' },
  { amount: '$170,000', count: 170000, text: 'Settlement obtained in a back injury case before the Virginia Workers’ Compensation Commission.', linkText: 'back injury', href: '/virginia-workers-comp-lawyer/virginia-back-injury-lawyer/' },
  { amount: '$170,000', count: 170000, text: 'Settlement obtained in a concussion/brain injury case before the Virginia Workers’ Compensation Commission', linkText: 'concussion/brain injury', href: '/concussion-brain-injury-workers-comp/' },
  { amount: '$150,000', count: 150000, text: 'Settlement in a concussion/brain injury case before the Virginia Workers’ Compensation Commission.', linkText: 'concussion/brain injury', href: '/concussion-brain-injury-workers-comp/' },
  { amount: '$150,000', count: 150000, text: 'Settlement obtained in a broken ankle case before the Virginia Workers’ Compensation Commission.', linkText: 'broken ankle', href: '/ankle-injury-workers-comp/' },
  { amount: '$140,000', count: 140000, text: 'Settlement obtained in a spinal injury case before the Virginia Workers’ Compensation Commission.', linkText: 'spinal injury', href: '/what-should-you-do-if-you-have-a-spine-injury-at-work/' },
  { amount: '$135,000', count: 135000, text: 'Settlement obtained in a contested femur fracture case before the Virginia Workers’ Compensation Commission.' },
  { amount: '$130,000', count: 130000, text: 'Settlement obtained in a disputed neck injury case before the Virginia Workers’ Compensation Commission.', linkText: 'neck injury', href: '/what-should-you-do-if-you-have-a-spine-injury-at-work/' },
];
---
<Base
  title={title}
  description={description}
  path="/results/"
  crumbs={[{ name: 'Case Results', path: '/results/' }]}
  overlay
>
  <PageHero title="Case Results" crumbs={[{ name: 'Case Results' }]} />

  <section class="section results-intro">
    <div class="wrap narrow prose">
      <p class="lead">
        These are past results in Virginia workers’ compensation cases, from back and spine injuries to
        brain injuries and broken bones. Many were heavily contested and settled at mediation before the
        Virginia Workers’ Compensation Commission. Every settlement had to be approved by the Commission.
      </p>
      <p>
        What a case settles for depends on the injury, the wages, the medical evidence, and how hard the
        insurance company fights. Here’s
        <a href="/virginia-workers-comp-lawyer/how-to-calculate-a-virginia-workers-comp-settlement/">how a Virginia settlement is calculated</a>
        and <a href="/work-injury-compensation/">what a work injury can be worth</a>.
      </p>
    </div>
  </section>

  <section class="section results contour tex-img results-page">
    <img class="contour-tex" data-src="/images/contour-map.svg" alt="" width="2560" height="1600" loading="lazy" decoding="async" />
    <div class="wrap">
      <div class="results-grid" data-stagger>
        {results.map((r) => (
          <article class="result">
            <p class="amount" data-count={r.count}>{r.amount}</p>
            <p>{r.href ? <>{r.text.split(r.linkText)[0]}<a href={r.href}>{r.linkText}</a>{r.text.split(r.linkText).slice(1).join(r.linkText)}</> : r.text}</p>
          </article>
        ))}
      </div>
      <p class="disclaimer" data-reveal>
        Amounts shown are gross, before attorney’s fees, costs, and liens. Every case is different. These results depended on facts unique to each case and do not
        predict or guarantee the result in yours.
      </p>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  /* Nov 3 2026 (Bryn approved the mockup): the home page's results look. Open columns on cream with an orange
     rule over each amount, faint dark map lines, and bearing ticks down both edges. The disclaimer stays below. */
  .results-page {
    padding-top: clamp(3rem, 7vw, 5rem);
    position: relative;
    background: #fff5d5;
    color: var(--forest);
  }
  .results-page :global(.contour-tex) {
    filter: brightness(0);
    opacity: 0.06;
  }
  .results-page::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    color: var(--forest);
    background:
      repeating-linear-gradient(180deg, currentColor 0 1.5px, transparent 1.5px 6rem) left 0 top 1.5rem / 1rem 100% no-repeat,
      repeating-linear-gradient(180deg, currentColor 0 1px, transparent 1px 1.5rem) left 0 top 1.5rem / 0.5rem 100% no-repeat,
      repeating-linear-gradient(180deg, currentColor 0 1.5px, transparent 1.5px 6rem) right 0 top 1.5rem / 1rem 100% no-repeat,
      repeating-linear-gradient(180deg, currentColor 0 1px, transparent 1px 1.5rem) right 0 top 1.5rem / 0.5rem 100% no-repeat;
  }
  .results-page :global(.results-grid) {
    gap: 2.25rem 1.75rem;
  }
  .results-page .result {
    background: none;
    box-shadow: none;
    border-radius: 0;
    border-top: 4px solid var(--amber);
    padding: 1rem 0 0;
  }
  .results-page .result:hover {
    transform: none;
  }
  .results-page .result .amount {
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--forest);
  }
  .results-page .result p {
    color: #3d5546;
  }
  .results-page .disclaimer {
    color: #4f6155; /* 6:1 on cream */
  }
  /* Fifteen cards: three across on desktop reads better than four. */
  @media (min-width: 62rem) {
    .results-page :global(.results-grid) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactSection from '../../components/ContactSection.astro';
import { site } from '../../data/site';

// Oct 31 SEO rewrite: answer-first FAQ with Code citations, checked by the Virginia comp authority
// check (SEO Audit file 15a). "Should I get a Workers’ Comp attorney" keeps the live wording. Answers
// are written fresh rather than copied from the hub FAQ, so the two pages don’t duplicate each other.
const title = 'Virginia Workers’ Comp FAQ: Deadlines, Pay, Doctors, Claims';
const description =
  'Straight answers to common Virginia workers’ comp questions: deadlines, how much it pays, choosing a doctor, denials, settlements, and more.';
const code = (sec: string, ch: string) =>
  `<a href="https://law.lis.virginia.gov/vacode/title65.2/chapter${ch}/section65.2-${sec}/" rel="noopener">Va. Code § 65.2-${sec}</a>`;

const more = [
  ['What happens when you file a Workers’ Comp claim?', '/what-happens-when-you-file-a-workers-comp-claim/'],
  ['What if a Workers’ Comp insurer delays my benefits?', '/what-if-a-workers-comp-insurer-delays-my-benefits/'],
  ['What’s the Workers’ Comp Process in Virginia?', '/workers-comp-process-in-virginia/'],
  ['What types of Workers’ Compensation settlements are there?', '/workers-comp-settlement-in-virginia/'],
  ['Should I accept a lump sum settlement for my Workers’ Comp claim?', '/should-i-accept-a-lump-sum-settlement-for-my-workers-comp-claim/'],
  ['How long can a Workers’ Comp claim stay open?', '/how-long-can-a-workers-comp-claim-stay-open/'],
  ['Can I receive Workers’ Comp and Social Security Disability at the same time?', '/virginia-workers-comp-lawyer/can-i-receive-workers-comp-and-social-security-disability-at-the-same-time/'],
  ['Does Virginia Workers’ Comp pay for lost wages?', '/virginia-workers-comp-lawyer/does-virginia-workers-comp-pay-for-lost-wages/'],
  ['Are Workers’ Comp benefits taxable?', '/are-workers-comp-benefits-taxable/'],
  ['How do you strengthen a Virginia Workers’ Comp case?', '/how-to-win-a-virginia-workers-comp-case/'],
  ['How do you settle a Virginia Workers’ Comp dispute?', '/virginia-work-injury-lawyer/how-to-settle-a-virginia-workers-comp-dispute/'],
  ['How is Workers’ Comp calculated in Virginia?', '/virginia-workers-comp-lawyer/how-is-workers-comp-calculated-in-virginia/'],
  ['How long do Virginia Workers’ Comp settlements take?', '/virginia-workers-comp-lawyer/how-long-do-virginia-workers-comp-settlements-take/'],
  ['How do you calculate a Virginia Workers’ Comp settlement?', '/virginia-workers-comp-lawyer/how-to-calculate-a-virginia-workers-comp-settlement/'],
  ['How do you prepare for a Virginia Workers’ Comp hearing?', '/virginia-workers-comp-lawyer/how-to-prepare-for-a-virginia-workers-comp-hearing/'],
  ['How do you prepare for an IME in Virginia?', '/virginia-workers-comp-lawyer/how-to-prepare-for-an-ime-in-virginia/'],
  ['If I get injured at work in Virginia, do I get paid?', '/virginia-workers-comp-lawyer/if-i-get-injured-at-work-in-virginia-do-i-get-paid/'],
  ['What does Workers’ Comp cover in Virginia?', '/virginia-workers-comp-lawyer/what-does-workers-comp-cover-in-virginia/'],
  ['What happens after a Workers’ Comp IME in Virginia?', '/virginia-workers-comp-lawyer/what-happens-after-a-workers-comp-ime-in-virginia/'],
  ['What happens if your Workers’ Comp claim is denied?', '/virginia-workers-comp-lawyer/what-happens-if-your-workers-comp-claim-is-denied/'],
  ['What is maximum medical improvement in Virginia Workers’ Comp claims?', '/virginia-workers-comp-lawyer/what-is-maximum-medical-improvement-in-virginia-workers-comp-claims/'],
  ['When does Virginia Workers’ Comp start paying?', '/virginia-workers-comp-lawyer/when-does-virginia-workers-comp-start-paying/'],
];
---
<Base
  title={title}
  description={description}
  path="/virginia-workers-comp-faq/"
  crumbs={[{ name: 'Virginia Workers’ Comp FAQ', path: '/virginia-workers-comp-faq/' }]}
  overlay
>
  <PageHero title="Virginia Workers’ Comp FAQ" crumbs={[{ name: 'Virginia Workers’ Comp FAQ' }]} />

  <div class="wrap page-body">
    <article class="prose">
      <h2 id="faq">Frequently Asked Questions</h2>
      <p class="lead">
        Short, direct answers to the questions injured workers ask most about Virginia workers’
        compensation. Each one links to a longer guide.
      </p>
      <div class="faq">
        <details open>
          <summary>What qualifies as a work accident in Virginia?</summary>
          <div class="answer">
            <p>
              Getting hurt at work doesn’t automatically mean workers’ comp pays. The injury must arise
              out of and in the course of your job, and it must be caused by an accident: an
              identifiable incident at a reasonably definite time that causes a sudden mechanical or
              structural change in your body (<Fragment set:html={code('101', '1')} />). Injuries that
              build up gradually from repetitive work generally do not count as an injury by accident.
            </p>
            <p>
              Fault generally doesn’t matter, but a willful failure to use a safety appliance or perform
              a statutory duty, or a willful breach of a known, reasonable rule of the employer, can bar
              recovery. The employer has the burden of proof (<Fragment set:html={code('306', '3')} />).
              Here’s <a href="/how-to-qualify-for-workers-comp-in-virginia/">how to qualify for workers’ comp in Virginia</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>How soon do I have to tell my employer?</summary>
          <div class="answer">
            <p>
              Give your employer written notice within 30 days of the accident, although exceptions
              exist (<Fragment set:html={code('600', '6')} />). Telling a supervisor out loud is a start,
              but put it in writing and keep a copy.
            </p>
          </div>
        </details>
        <details>
          <summary>How long do I have to file a workers’ comp claim?</summary>
          <div class="answer">
            <p>
              A claim must be on file with the Virginia Workers’ Compensation Commission within two years
              of the accident, although exceptions apply, or the right to benefits may be lost
              (<Fragment set:html={code('601', '6')} />).
            </p>
            <p>
              A second deadline catches people later: if you go back to work and are disabled again, you
              generally have to file within 24 months from the last day for which you were paid compensation
              under an award, although exceptions can apply (<Fragment set:html={code('708', '7')} />). Here’s
              <a href="/how-to-file-a-workers-comp-claim/">how to file a workers’ comp claim</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>Do I need to file a claim if the insurance company is already paying?</summary>
          <div class="answer">
            <p>
              Yes. An insurance company can accept your injury and pay for a while without a claim ever
              being filed. If it later stops and the two-year deadline has passed, you may have no way to
              get benefits back. A claim on file with the Commission protects that deadline.
            </p>
          </div>
        </details>
        <details>
          <summary>Can I choose my own doctor?</summary>
          <div class="answer">
            <p>
              Usually not at first. Your employer must offer you a panel of at least three doctors, and
              you choose your treating doctor from that list. If the employer doesn’t offer a panel, you
              can generally choose your own. Once you have a treating doctor, you generally can’t switch
              without the insurance company’s agreement or the Commission’s permission
              (<Fragment set:html={code('603', '6')} />).
            </p>
          </div>
        </details>
        <details>
          <summary>How much does Virginia workers’ comp pay?</summary>
          <div class="answer">
            <p>
              While a doctor says you can’t work, two-thirds of your average weekly wage, up to a weekly
              maximum. For injuries on or after July 1, 2026, the maximum is $1,507.01 a week
              (<Fragment set:html={code('500', '5')} />). If you are back at work on light duty for less
              pay, it pays two-thirds of the difference (<Fragment set:html={code('502', '5')} />). Here’s
              <a href="/virginia-workers-comp-lawyer/how-is-workers-comp-calculated-in-virginia/">how Virginia workers’ comp is calculated</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>When do the checks start?</summary>
          <div class="answer">
            <p>
              Wage checks don’t cover the first seven days out of work. Pay starts on day 8, and the first
              seven days are paid back if you are out more than three weeks
              (<Fragment set:html={code('509', '5')} />). Medical treatment is covered from the first day.
              Here’s <a href="/virginia-workers-comp-lawyer/when-does-virginia-workers-comp-start-paying/">when Virginia workers’ comp starts paying</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>What benefits can I receive?</summary>
          <div class="answer">
            <ul>
              <li>Wage checks while you can’t work, or work for less pay</li>
              <li>Medical treatment that is reasonable, necessary, and causally related to the accident</li>
              <li>Vocational rehabilitation to help you get back to work</li>
              <li>Home and vehicle modifications for certain serious injuries</li>
              <li>Permanent partial disability for permanent loss of use of certain body parts, and for severe scarring or disfigurement</li>
              <li>Permanent and total disability benefits for the most serious injuries</li>
              <li>Death benefits for a worker’s dependents</li>
            </ul>
            <p>
              A lump-sum settlement is voluntary; nobody can force you or the insurance company into one.
              Workers’ comp does not pay for pain and suffering. Here’s
              <a href="/virginia-workers-comp-lawyer/what-does-workers-comp-cover-in-virginia/">what workers’ comp covers in Virginia</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>Can I sue my employer for a work injury?</summary>
          <div class="answer">
            <p>
              No. For an accident covered by workers’ comp, workers’ comp is your remedy against your
              employer and coworkers (<Fragment set:html={code('307', '3')} />). You may be able to sue an
              outside party who caused the injury, such as a negligent driver, as long as they are not a
              coworker or in the same business as your employer (<Fragment set:html={code('309', '3')} />).
            </p>
          </div>
        </details>
        <details>
          <summary>What if my claim is denied or my checks stop?</summary>
          <div class="answer">
            <p>
              A denial isn’t the end. You can ask the Commission for a hearing no matter what the
              insurance company decides, and a deputy commissioner decides the dispute. If a payment under
              an award is more than two weeks late, the law adds 20 percent to it unless the Commission
              finds the delay had good cause outside the employer’s control (<Fragment set:html={code('524', '5')} />). Here’s
              <a href="/virginia-workers-comp-lawyer/what-happens-if-your-workers-comp-claim-is-denied/">what happens if your claim is denied</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>Do I have to accept a settlement?</summary>
          <div class="answer">
            <p>
              No. Settlements are voluntary, and the Commission must approve every one
              (<Fragment set:html={code('701', '7')} />). Most Virginia settlements are full and final:
              one lump sum that closes the whole case, including future medical care, so it has to account
              for everything you will need. Here’s more on
              <a href="/workers-comp-settlement-in-virginia/">workers’ comp settlements in Virginia</a>.
            </p>
          </div>
        </details>
        <details>
          <summary>What do I have to do to receive workers’ comp benefits?</summary>
          <div class="answer">
            <ul>
              <li>Give your employer written notice of the accident and injury as soon as possible.</li>
              <li>File a claim with the Virginia Workers’ Compensation Commission. The Commission decides whether you are entitled to benefits, but only if a claim is filed.</li>
              <li>Get medical treatment, tell every doctor the injury happened at work, and keep your records.</li>
              <li>Keep copies of anything about the accident from your employer, and your pay stubs.</li>
            </ul>
          </div>
        </details>
        <details>
          <summary>Should I get a Workers’ Comp attorney in VA?</summary>
          <div class="answer">
            <p>It depends.</p>
            <p>
              Sometimes we will speak with clients and recommend they not retain counsel. Some cases
              are complex and some are not. We are happy to help you make a good decision. No
              obligations. No heavy-handedness. Just help for you. Call
              <a href="/">Pathfinder Injury Law</a> today: <a href={site.phoneHref}>(804) 505-0633</a>.
            </p>
          </div>
        </details>
      </div>

      <h2 id="more">Additional FAQs</h2>
      <ul class="more-faq">
        {more.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </article>

    <aside class="side" aria-label="Contact">
      <div class="side-card side-call">
        <h2>Free Consultation</h2>
        <a class="cta-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
        <a class="btn btn-primary" href="#contact">Get Help Now</a>
      </div>
      <nav class="side-card" aria-label="On this page">
        <h2>On This Page</h2>
        <ul class="toc">
          <li><a href="#faq">Frequently Asked Questions</a></li>
          <li><a href="#more">Additional FAQs</a></li>
        </ul>
      </nav>
    </aside>
  </div>

  <ContactSection />
</Base>

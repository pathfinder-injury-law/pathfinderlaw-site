{
  // Must match the Worker name chosen in the Cloudflare dashboard.
  "name": "pathfinderlaw-site",
  "compatibility_date": "2026-10-27",
  // The live site is reached only at pathfinderlaw.com. Turn off the
  // extra *.workers.dev address and per-version preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Serve the built site as static files. No server code runs.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
